<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Invoice {{invoiceNumber}}</title>
  <style>
    /* Mirrors the client's delivery-challan stationery: one ruled outer frame,
       every block in its own bordered band, black on white so it photocopies
       and faxes cleanly. Kept deliberately plain — this is a legal document,
       not a branded one. */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body {
      font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
      color: #000;
      font-size: 10px;
      line-height: 1.35;
    }
    /* The frame spans the whole printed page, like the client's stationery:
       A4 (297mm) less the 12mm/14mm print margins set in invoice-pdf.service.
       min-height (not height) so a long invoice still flows onto page two. */
    .sheet {
      border: 1.2px solid #000;
      /* 269mm, not the full 271mm of printable height: Chromium rounds layout
         to device pixels, and at exactly 271mm the rounding tipped the frame
         past the page and emitted a blank second sheet. */
      min-height: 269mm;
      display: flex;
      flex-direction: column;
    }
    .band { border-bottom: 1px solid #000; }
    .cols { display: flex; }
    .cols > .c { flex: 1; padding: 5px 8px; }
    .cols > .c + .c { border-left: 1px solid #000; }
    /* Everything below the signature row is one open, full-width area with the
       QR at its top-left — no centre divider past that point. It flexes so the
       frame still reaches the foot of the page. */
    .tail { flex: 1 1 auto; padding: 8px; }

    /* ---- Header ---- */
    .head { display: flex; align-items: flex-start; padding: 8px; gap: 10px; }
    .head .logo { width: 62px; height: 62px; object-fit: contain; flex: 0 0 auto; }
    /* min-width:0 lets the address column actually shrink instead of forcing
       the row wider than the frame. The title is operator-editable, so it is
       capped and allowed to wrap: an unusually long one costs itself a second
       line rather than crushing the address beside it. */
    .head .biz { flex: 1 1 auto; min-width: 0; overflow-wrap: anywhere; }
    .head .biz .nm { font-size: 15px; font-weight: 700; letter-spacing: .2px; }
    .head .biz .ln { font-size: 8.5px; margin-top: 1px; }
    /* flex-shrink:0 is the important bit. With the default shrink of 1 the
       column collapsed to its longest WORD and "DELIVERY CHALLAN" broke onto
       two lines; the address column (which has min-width:0) is the one that
       should give up space. max-width is only the escape hatch for a title long
       enough that wrapping beats overflowing the sheet. */
    .head .titlecol { flex: 0 0 auto; max-width: 60%; align-self: center; text-align: right; }
    .head .title { font-size: 21px; font-weight: 700; letter-spacing: .5px; overflow-wrap: anywhere; }
    /* PAID / CREDIT / PART PAID, boxed under the title. inline-block so the rule
       hugs the word instead of running the width of the column. */
    .head .paystatus {
      display: inline-block; margin-top: 4px; padding: 1px 7px;
      border: 1px solid #000; font-size: 10px; font-weight: 700; letter-spacing: .5px;
    }

    /* ---- Label : value rows ---- */
    .kv { display: flex; font-size: 9px; margin-top: 1px; }
    .kv .k { width: 78px; flex: 0 0 auto; }
    .kv .s { width: 8px; flex: 0 0 auto; }
    .kv .v { font-weight: 700; }

    /* ---- Party ---- */
    .party .nm { font-size: 11.5px; font-weight: 700; }
    .party .sub { font-size: 9px; margin-top: 1px; }
    .repl { float: right; font-weight: 700; color: #0284c7; font-size: 10px; }

    /* ---- Items ---- */
    table.items { width: 100%; border-collapse: collapse; }
    table.items th, table.items td { border: 1px solid #000; padding: 4px 5px; font-size: 9px; }
    table.items thead th { font-weight: 700; background: #fff; }
    table.items td.n, table.items th.n { text-align: right; white-space: nowrap; }
    table.items td.c, table.items th.c { text-align: center; }
    table.items tbody td.desc { font-weight: 600; }
    /* Repeat the header when a long invoice breaks across pages. */
    table.items thead { display: table-header-group; }
    table.items tr { page-break-inside: avoid; }

    /* ---- Totals / payment note ---- */
    /* The column itself has no padding — the signature panel's top rule has to
       span its full width — so the totals get their breathing room from the
       cells instead. Without this the labels sit flush against the centre rule. */
    .totals { width: 100%; border-collapse: collapse; margin: 5px 0; }
    .totals td { padding: 2px 0; font-size: 9.5px; }
    .totals td:first-child { padding-left: 10px; }
    .totals td.v { text-align: right; white-space: nowrap; padding-right: 10px; }
    .totals tr.big td { font-size: 11.5px; font-weight: 700; padding-top: 4px; }
    .paynote .t { font-weight: 700; font-style: italic; text-decoration: underline; font-size: 9.5px; }
    .paynote .l { font-weight: 700; font-size: 10px; margin-top: 2px; }

    /* ---- Signature ---- */
    .sign {
      border-top: 1px solid #000;
      min-height: 74px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      text-align: center;
      padding: 6px 8px;
    }

    /* ---- QR ---- */
    .qr { display: flex; align-items: center; gap: 8px; }
    .qr img { width: 76px; height: 76px; }
    .qr .cap { font-size: 9px; }
    .qr .cap b { display: block; font-size: 10.5px; }

  </style>
</head>
<body>
  <div class="sheet">

    <!-- ===== Letterhead + document title ===== -->
    <div class="band head">
      {{#if logoDataUri}}<img class="logo" src="{{{logoDataUri}}}" alt="" />{{/if}}
      <div class="biz">
        <div class="nm">{{supplierName}}</div>
        {{#if supplierAddress}}<div class="ln">{{supplierAddress}}</div>{{/if}}
        {{#if supplierContact}}<div class="ln">{{supplierContact}}</div>{{/if}}
        {{!-- GSTIN / D.L. are suppressed independently via Settings ->
              Invoice & Payment. Each is its own flag because a business may be
              registered for one and not the other, and the same document is
              handed to buyers who need to see different things. --}}
        <div class="ln">
          {{#if showBusinessGstin}}GSTIN: {{supplierGstin}}{{/if}}
          {{#if showBusinessDl}}&nbsp;&nbsp; D.L.No: {{supplierDlNumber}}{{/if}}
        </div>
      </div>
      <div class="titlecol">
        <div class="title">{{documentTitle}}</div>
        {{!-- Whether the person handing this over should be collecting money is
              the one thing worth reading off the top of the page, so it goes
              with the title rather than being buried in the totals column. --}}
        {{#if payStatus}}<div class="paystatus">{{payStatus}}</div>{{/if}}
      </div>
    </div>

    <!-- ===== Invoice meta ===== -->
    <div class="band cols">
      <div class="c">
        <div class="kv"><span class="k">Invoice No</span><span class="s">:</span><span class="v">{{invoiceNumber}}</span></div>
        <div class="kv"><span class="k">Invoice Date</span><span class="s">:</span><span class="v">{{day date}}</span></div>
      </div>
      <div class="c">
        {{#if salespersonName}}
        <div class="kv"><span class="k">Sales person</span><span class="s">:</span><span class="v">{{salespersonName}}</span></div>
        {{/if}}
        {{#if dueDate}}
        <div class="kv"><span class="k">Due Date</span><span class="s">:</span><span class="v">{{day dueDate}}</span></div>
        {{/if}}
      </div>
    </div>

    <!-- ===== Bill to ===== -->
    <div class="band party" style="padding: 5px 8px;">
      {{#if isReplacement}}<span class="repl">REPLACEMENT - NO CHARGE</span>{{/if}}
      <div class="nm">{{customerName}}{{#if customerPhone}} ({{customerPhone}}){{/if}}</div>
      <div class="sub">
        {{#if customerAddress}}{{customerAddress}}{{/if}}
        {{#if customerBranch}} &nbsp;|&nbsp; {{customerBranch}}{{/if}}
        {{#if showCustomerGstin}} &nbsp;|&nbsp; GSTIN: {{customerGstin}}{{/if}}
        {{#if showCustomerDl}} &nbsp;|&nbsp; D.L.No: {{customerDlNumber}}{{/if}}
      </div>
    </div>

    <!-- ===== Items ===== -->
    <table class="items">
      <thead>
        <tr>
          <th class="c" style="width:26px;">#</th>
          <th>Description</th>
          <th class="n" style="width:52px;">MRP</th>
          <th style="width:66px;">Batch No</th>
          <th class="c" style="width:48px;">Expiry</th>
          <th class="c" style="width:42px;">Qty</th>
          <th class="n" style="width:60px;">Rate</th>
          <th class="c" style="width:38px;">GST%</th>
          <th class="n" style="width:68px;">Amount</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td class="c">{{inc @index}}</td>
          <td class="desc">{{this.productName}}</td>
          <td class="n">{{money this.mrp}}</td>
          {{!-- With stock tracking OFF a line carries no batch, and the stored
                expiryDate defaults to "today" when left blank — which must NOT
                print as a real expiry. Both fall back to a dash. --}}
          <td>{{#if this.batchNumber}}{{this.batchNumber}}{{else}}-{{/if}}</td>
          <td class="c">{{#if this.batchNumber}}{{expiry this.expiryDate}}{{else}}-{{/if}}</td>
          <td class="c">{{this.quantity}}</td>
          <td class="n">{{money this.rate}}</td>
          <td class="c">{{this.gstPercent}}</td>
          <td class="n">{{money this.amount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- ===== Payment note | totals + signature ===== -->
    <div class="band cols">
      {{!-- Payment note. Every line comes from Settings -> Invoice & Payment;
            these were hard-coded names and numbers before, so they could only be
            changed by editing this template. The whole block is skipped when
            nothing is configured, rather than printing a bare heading. --}}
      <div class="c paynote">
        {{#if hasPaymentNote}}
        <div class="t">Kindly deposit Payment through Our</div>
        {{#each gpayLines}}
        {{#unless @first}}<div class="l" style="text-align:center; width:150px;">OR</div>{{/unless}}
        <div class="l">{{#if @first}}GPAY: {{/if}}{{this.name}}{{#if this.number}} - {{this.number}}{{/if}}</div>
        {{/each}}
        {{!-- Bank block sits under a gap so the UPI numbers and the account
              read as two groups, matching the frontend jsPDF renderer's
              `gapBefore` spacing. The gap is only applied when there are GPay
              lines above it to separate from. --}}
        {{#if hasBank}}
        <div{{#if gpayLines.length}} style="margin-top:9px;"{{/if}}>
          {{#if bankName}}<div class="l">{{bankName}}</div>{{/if}}
          {{#if bankAccountNumber}}<div class="l">A/C: {{bankAccountNumber}}</div>{{/if}}
          {{#if bankIfsc}}<div class="l">IFSC: {{bankIfsc}}</div>{{/if}}
        </div>
        {{/if}}
        {{/if}}
      </div>
      <div class="c" style="padding:0;">
        <table class="totals">
          <tr><td>Sub Total</td><td class="v">{{money subtotal}}</td></tr>
          {{#if showDiscount}}<tr><td>Discount</td><td class="v">- {{money productDiscount}}</td></tr>{{/if}}
          <tr><td>Taxable</td><td class="v">{{money taxableAmount}}</td></tr>
          {{#if showCgst}}<tr><td>CGST</td><td class="v">{{money cgst}}</td></tr>{{/if}}
          {{#if showSgst}}<tr><td>SGST</td><td class="v">{{money sgst}}</td></tr>{{/if}}
          {{#if showIgst}}<tr><td>IGST</td><td class="v">{{money igst}}</td></tr>{{/if}}
          {{#if showDelivery}}<tr><td>Delivery / Packaging</td><td class="v">{{money deliveryCharge}}</td></tr>{{/if}}
          {{#each charges}}<tr><td>{{this.label}}</td><td class="v">{{money this.amount}}</td></tr>{{/each}}
          {{#if showRoundOff}}<tr><td>Round Off</td><td class="v">{{money roundOff}}</td></tr>{{/if}}
          <tr class="big"><td>Total</td><td class="v">{{money grandTotal}}</td></tr>
          {{#if showPaid}}<tr><td>Paid</td><td class="v">{{money amountPaid}}</td></tr>{{/if}}
          {{#if showOutstanding}}<tr class="big"><td>Balance Due</td><td class="v">{{money outstanding}}</td></tr>{{/if}}
        </table>
        <!-- Signature panel, ruled off from the totals above it. -->
        <div class="sign">
          <div>For {{supplierName}}</div>
        </div>
      </div>
    </div>

    <!-- ===== Pay QR, directly under the full-width rule ===== -->
    <div class="tail">
      {{#if qrDataUri}}
      <div class="qr">
        <img src="{{{qrDataUri}}}" alt="Scan to pay" />
        <div class="cap">
          {{#if showOutstanding}}<b>{{money outstanding}}</b>{{/if}}
          Scan the QR code to Pay
        </div>
      </div>
      {{/if}}
    </div>

  </div>
</body>
</html>
