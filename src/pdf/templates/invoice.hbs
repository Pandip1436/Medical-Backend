<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Invoice {{invoiceNumber}}</title>
  <style>
    /* ---- A4 print reset ---- */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --ink:      #1a1a1a;   /* primary text            */
      --muted:    #6b7280;   /* secondary / labels      */
      --line:     #e5e7eb;   /* hairlines               */
      --brand:    #0f766e;   /* teal — medical/clinical */
      --brand-bg: #f0fdfa;   /* brand tint              */
      --zebra:    #f9fafb;   /* table striping          */
    }
    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body {
      font-family: 'Helvetica Neue', Arial, 'Segoe UI', sans-serif;
      color: var(--ink);
      font-size: 11px;
      line-height: 1.45;
    }
    .wrap { width: 100%; }

    /* ---- Header ---- */
    .header { display: flex; justify-content: space-between; align-items: flex-start; }
    .supplier-name { font-size: 20px; font-weight: 700; color: var(--brand); letter-spacing: .2px; }
    .supplier-meta { color: var(--muted); margin-top: 4px; max-width: 320px; }
    .supplier-meta .reg { color: var(--ink); margin-top: 3px; }
    .supplier-meta .reg b { color: var(--ink); font-weight: 600; }

    .doc-box { text-align: right; min-width: 220px; }
    .doc-title { font-size: 22px; font-weight: 700; letter-spacing: 1px; color: var(--ink); }
    .doc-title .sub { display: block; font-size: 9px; font-weight: 600; color: var(--muted); letter-spacing: 2px; }
    .doc-meta { margin-top: 8px; font-size: 10.5px; }
    .doc-meta div { margin-top: 2px; }
    .doc-meta .k { color: var(--muted); display: inline-block; min-width: 64px; text-align: right; padding-right: 8px; }
    .doc-meta .v { font-weight: 600; }

    .rule { height: 3px; background: var(--brand); margin: 14px 0 0; border-radius: 2px; }

    /* ---- Parties ---- */
    .parties { display: flex; gap: 16px; margin-top: 16px; }
    .party { flex: 1; border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px; }
    .party.bill { background: var(--brand-bg); border-color: #cceae6; }
    .party h4 { font-size: 9px; letter-spacing: 1.2px; text-transform: uppercase; color: var(--brand); margin-bottom: 5px; }
    .party .name { font-size: 13px; font-weight: 700; }
    .party .row { color: var(--ink); margin-top: 2px; }
    .party .row .lbl { color: var(--muted); }
    .party .qr { text-align: center; }
    .party .qr img { width: 104px; height: 104px; }
    .party .qr .cap { font-size: 9px; color: var(--muted); margin-top: 2px; }
    .party .qr .amt { font-size: 12px; font-weight: 700; color: var(--brand); }

    /* ---- Items table ---- */
    table.items { width: 100%; border-collapse: collapse; margin-top: 18px; }
    table.items thead th {
      background: var(--brand);
      color: #fff;
      font-size: 9.5px;
      letter-spacing: .3px;
      text-transform: uppercase;
      font-weight: 600;
      padding: 8px 8px;
      text-align: left;
    }
    table.items thead th.num { text-align: right; }
    table.items thead th.ctr { text-align: center; }
    table.items tbody td { padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
    table.items tbody tr:nth-child(even) { background: var(--zebra); }
    table.items td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    table.items td.ctr { text-align: center; }
    table.items td.med { font-weight: 600; }
    table.items td.idx { color: var(--muted); text-align: center; width: 26px; }
    .batch { font-family: 'Courier New', monospace; font-size: 10px; }

    /* ---- Totals ---- */
    .foot { display: flex; justify-content: space-between; margin-top: 16px; gap: 24px; }
    .notes { flex: 1; color: var(--muted); font-size: 10px; }
    .notes .terms-title { color: var(--ink); font-weight: 600; font-size: 10px; margin-bottom: 3px; }

    .totals { width: 280px; }
    .totals table { width: 100%; border-collapse: collapse; }
    .totals td { padding: 4px 8px; }
    .totals td.k { color: var(--muted); }
    .totals td.v { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
    .totals tr.grand td { border-top: 2px solid var(--ink); border-bottom: 2px solid var(--ink); font-size: 13px; }
    .totals tr.grand td.k { color: var(--ink); font-weight: 700; }
    .totals tr.grand td.v { color: var(--brand); }
    .totals tr.out td { color: #b91c1c; font-weight: 700; }

    /* ---- Page footer ---- */
    .pagefoot { margin-top: 26px; padding-top: 8px; border-top: 1px solid var(--line); text-align: center; color: var(--muted); font-size: 9px; }
    .pagefoot .sign { float: right; text-align: center; color: var(--ink); }
  </style>
</head>
<body>
  <div class="wrap">

    <!-- ===== HEADER: Supplier (left) + Invoice meta (right) ===== -->
    <div class="header">
      <div>
        <div class="supplier-name">{{supplierName}}</div>
        <div class="supplier-meta">
          {{#if supplierAddress}}<div>{{supplierAddress}}</div>{{/if}}
          {{#if supplierContact}}<div>{{supplierContact}}</div>{{/if}}
          <div class="reg">
            {{#if supplierGstin}}<span><b>GSTIN:</b> {{supplierGstin}}</span>{{/if}}
            {{#if supplierDlNumber}}<span>&nbsp;&nbsp;<b>D.L. No:</b> {{supplierDlNumber}}</span>{{/if}}
          </div>
        </div>
      </div>

      <div class="doc-box">
        <div class="doc-title">TAX INVOICE<span class="sub">ORIGINAL FOR RECIPIENT</span></div>
        <div class="doc-meta">
          <div><span class="k">Invoice #</span><span class="v">{{invoiceNumber}}</span></div>
          <div><span class="k">Date</span><span class="v">{{day date}}</span></div>
          {{#if dueDate}}<div><span class="k">Due Date</span><span class="v">{{day dueDate}}</span></div>{{/if}}
        </div>
      </div>
    </div>

    <div class="rule"></div>

    <!-- ===== PARTIES: Bill To (hospital) + optional Pay QR ===== -->
    <div class="parties">
      <div class="party bill">
        <h4>Bill To</h4>
        <div class="name">{{customerName}}</div>
        {{#if customerBranch}}<div class="row"><span class="lbl">Branch:</span> {{customerBranch}}</div>{{/if}}
        {{#if customerAddress}}<div class="row">{{customerAddress}}</div>{{/if}}
        {{#if customerPhone}}<div class="row"><span class="lbl">Phone:</span> {{customerPhone}}</div>{{/if}}
        {{#if customerGstin}}<div class="row"><span class="lbl">GSTIN:</span> {{customerGstin}}</div>{{/if}}
        {{#if customerDlNumber}}<div class="row"><span class="lbl">D.L. No:</span> {{customerDlNumber}}</div>{{/if}}
      </div>

      {{#if qrDataUri}}
      <div class="party qr">
        <h4>Scan &amp; Pay (UPI)</h4>
        <img src="{{{qrDataUri}}}" alt="Pay via UPI" />
        {{#if showOutstanding}}<div class="amt">{{money outstanding}}</div>{{/if}}
        <div class="cap">Scan with any UPI app</div>
      </div>
      {{/if}}
    </div>

    <!-- ===== ITEMS ===== -->
    <table class="items">
      <thead>
        <tr>
          <th class="ctr">#</th>
          <th>Medicine Name</th>
          <th>Batch No.</th>
          <th class="ctr">Expiry</th>
          <th class="num">Qty</th>
          <th class="num">MRP</th>
          <th class="num">Sale Price</th>
          <th class="num">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td class="idx">{{inc @index}}</td>
          <td class="med">{{this.productName}}</td>
          <td><span class="batch">{{this.batchNumber}}</span></td>
          <td class="ctr">{{expiry this.expiryDate}}</td>
          <td class="num">{{this.quantity}}</td>
          <td class="num">{{money this.mrp}}</td>
          <td class="num">{{money this.rate}}</td>
          <td class="num">{{money this.amount}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- ===== FOOTER: notes + totals ===== -->
    <div class="foot">
      <div class="notes">
        <div class="terms-title">Terms &amp; Notes</div>
        <div>Goods once sold are subject to the terms of supply. Please verify batch &amp; expiry on receipt.</div>
        <div>Payment due by the date stated above. For UPI payment, scan the QR code provided.</div>
      </div>

      <div class="totals">
        <table>
          <tr><td class="k">Subtotal</td><td class="v">{{money subtotal}}</td></tr>
          {{#if showDiscount}}<tr><td class="k">Discount</td><td class="v">- {{money productDiscount}}</td></tr>{{/if}}
          <tr><td class="k">Taxable Value</td><td class="v">{{money taxableAmount}}</td></tr>
          {{#if showCgst}}<tr><td class="k">CGST</td><td class="v">{{money cgst}}</td></tr>{{/if}}
          {{#if showSgst}}<tr><td class="k">SGST</td><td class="v">{{money sgst}}</td></tr>{{/if}}
          {{#if showIgst}}<tr><td class="k">IGST</td><td class="v">{{money igst}}</td></tr>{{/if}}
          {{#if showRoundOff}}<tr><td class="k">Round Off</td><td class="v">{{money roundOff}}</td></tr>{{/if}}
          <tr class="grand"><td class="k">Grand Total</td><td class="v">{{money grandTotal}}</td></tr>
          {{#if showPaid}}<tr><td class="k">Amount Paid</td><td class="v">{{money amountPaid}}</td></tr>{{/if}}
          {{#if showOutstanding}}<tr class="out"><td class="k">Balance Due</td><td class="v">{{money outstanding}}</td></tr>{{/if}}
        </table>
      </div>
    </div>

    <div class="pagefoot">
      <span class="sign">For {{supplierName}}<br/><br/>Authorised Signatory</span>
      This is a computer-generated invoice and does not require a physical signature.
    </div>

  </div>
</body>
</html>
