generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's connection pooler runs in transaction mode and doesn't hold
  // session-level advisory locks. Prisma uses an advisory lock during
  // `migrate deploy`/`migrate dev`, so we point those commands at the
  // non-pooler hostname via DIRECT_URL. Runtime traffic still uses the
  // pooled DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ── Branch / Location ─────────────────────────────────────────
model Branch {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique  // short code e.g. "HQ", "BR1"
  address     String?
  phone       String?
  email       String?
  gstin       String?
  drugLicense String?
  invoicePrefix String? /// @deprecated — use NumberingConfig. No longer read by DocumentNumberingService.
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  users           User[]
  userAccess      UserBranch[]
  invoices        Invoice[]
  expenses        Expense[]
  purchaseOrders  PurchaseOrder[]
  grns            GRN[]
  creditNotes     CreditNote[]
  purchaseReturns PurchaseReturn[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  doctors         Doctor[]
  prescriptions   Prescription[]
  notifications   Notification[]
  payments        Payment[]
  supplierPayments SupplierPayment[]
  refunds         Refund[]
  reminders       CustomerReminder[]
  categories      Category[]
  supplierActivities SupplierActivity[]
  customerActivities CustomerActivity[]
  leads              Lead[]
  contacts           Contact[]
  companies          Company[]
  leadActivities     LeadActivity[]
  integrationCredentials IntegrationCredential[]
  integrationSyncJobs    IntegrationSyncJob[]
  paymentLinks       PaymentLink[]
  whatsappMessages   WhatsAppMessage[]
  numberingConfigs   NumberingConfig[]
  deliveries         DeliveryTracking[]
}

// ── Users & Auth ──────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String
  password       String    // bcrypt hashed
  role           Role      @default(PHARMACIST) // primary role (highest-precedence of `roles`) — kept for display/behaviour consumers
  roles          Role[]    @default([])         // full set of roles; drives all permission checks
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  branchId       String?   // home/default branch (auto-selected on login)
  branch         Branch?   @relation(fields: [branchId], references: [id])
  branchAccess   UserBranch[]                    // allowed branch set (empty for SUPER_ADMIN = all)
  commissionRate Decimal   @default(0) // % commission for SALESPERSON role
  preferences    Json      @default("{}") // per-user UI prefs (e.g. table column visibility) — client-managed blob
  createdAt      DateTime  @default(now())
  invoices             Invoice[]          @relation("UserInvoices")
  salespersonInvoices  Invoice[]          @relation("SalespersonInvoices")
  auditLogs            AuditLog[]
  approvalRequests     ApprovalRequest[]  @relation("ApprovalRequests")
  approvalReviews      ApprovalRequest[]  @relation("ApprovalReviews")
  supplierActivities   SupplierActivity[]
  customerActivities   CustomerActivity[]
  sharedFiles          SharedFile[]
  assignedLeads        Lead[]             @relation("LeadAssignee")
  ownedContacts        Contact[]          @relation("ContactOwner")
  leadActivities       LeadActivity[]
  invoiceEdits         InvoiceEditAudit[] @relation("InvoiceEdits")
  backups              Backup[]
  creditNoteReviews    CreditNote[]       @relation("CreditNoteReviews")
  deliveries           DeliveryTracking[] @relation("UserDeliveries")
}

// Join table: which branches a user may access (the "allowed set").
// A user picks one active branch in the header; the backend validates it
// against this set. SUPER_ADMIN has no rows here and may access every branch.
model UserBranch {
  id       String @id @default(cuid())
  userId   String
  branchId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  INVENTORY_MANAGER
  ACCOUNTANT
  SALESPERSON
}

// ── Customers ─────────────────────────────────────────────────
model Customer {
  id                 String         @id @default(cuid())
  name               String
  phone              String
  alternatePhone     String?
  email              String?
  address            String?
  type               CustomerType   @default(RETAIL)
  doctorRef          String?
  referredBy         String?        // salesperson name
  creditLimit        Decimal        @default(0)
  currentOutstanding Decimal        @default(0)
  gstin              String?
  dlNumber           String?
  registrationNumber String?   // For DOCTOR type: Medical Council Reg. No.
  notes              String?
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id])
  whatsappOptIn      Boolean        @default(true)  // customer-level consent for transactional WhatsApp messages
  whatsappNumber     String?        // override of `phone` if WhatsApp lives on a different number
  createdAt          DateTime       @default(now())
  invoices           Invoice[]
  prescriptions      Prescription[]
  creditNotes        CreditNote[]
  quotations         Quotation[]
  payments           Payment[]
  refunds            Refund[]
  reminders          CustomerReminder[]
  activities         CustomerActivity[]
  promotedFromContact Contact?           @relation("ContactPromotion")
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DOCTOR
}

// ── Shared files ──────────────────────────────────────────────
// Temporary public links for sharing PDFs (invoices, quotations) with
// customers via WhatsApp etc. The id is also the on-disk filename stub;
// expired rows are cleaned up by a daily scheduler and the static-serve
// path 404s once the file is gone.
model SharedFile {
  id          String   @id @default(cuid())
  filename    String   // original filename (for Content-Disposition / display)
  mimeType    String
  sizeBytes   Int
  label       String?  // optional caller-supplied tag, e.g. "INV-123"
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  @@index([expiresAt])
}

// ── Prescriptions ─────────────────────────────────────────────
model Prescription {
  id         String    @id @default(cuid())
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  doctorName String
  imageUrl   String?   // uploaded file path / S3 URL
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  validUntil DateTime?
}

// ── Categories ────────────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?   // hex color for UI badge
  isActive    Boolean   @default(true)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name, branchId])
}

// ── Products & Batches ────────────────────────────────────────
model Product {
  id               String           @id @default(cuid())
  name             String
  genericName      String
  saltComposition  String?
  manufacturer     String
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  subCategory      String?
  packSize         String           @default("")
  unitOfMeasure    String           @default("")
  schedule         Schedule         @default(NONE)
  hsnCode          String
  isNarcotic       Boolean          @default(false)
  storageCondition StorageCondition @default(ROOM_TEMP)
  mrp              Decimal
  purchaseRate     Decimal          @default(0)
  sellingRate      Decimal
  wholesaleRate    Decimal          @default(0)
  gstRate          Decimal
  minStock         Int
  maxStock         Int              @default(0)
  reorderQty       Int              @default(0)
  rackLocation     String           @default("")
  barcode          String?
  totalStock       Int              @default(0)
  isActive         Boolean          @default(true)
  branchId         String?
  branch           Branch?          @relation(fields: [branchId], references: [id])
  // Optional explicit override for which supplier to ping when stock runs low.
  // When null the LowStockNotificationListener falls back to the most recent
  // Batch.supplierId for this product.
  preferredSupplierId String?
  preferredSupplier   Supplier?     @relation("ProductPreferredSupplier", fields: [preferredSupplierId], references: [id])
  batches          Batch[]
  alternatives     Product[]        @relation("Alternatives")
  alternativesOf   Product[]        @relation("Alternatives")
  adjustmentLogs   StockAdjustmentLog[]
  // Delivery date of the GRN that last set this product's master mrp/purchaseRate.
  // Guards against a back-dated GRN overwriting newer pricing (see GrnService).
  // Null = master price has never been set from a dated GRN.
  lastPriceUpdate  DateTime?
  createdAt        DateTime         @default(now())

  @@unique([barcode, branchId])
}

model StockAdjustmentLog {
  id            String   @id @default(cuid())
  adjustmentNo  String?
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId       String
  batchNumber   String
  userId        String
  userName      String
  reason        String
  previousQty   Int
  adjustedQty   Int
  diff          Int
  notes         String?
  branchId      String?
  createdAt     DateTime @default(now())
}

enum Schedule {
  NONE
  H
  H1
  X
}

enum StorageCondition {
  ROOM_TEMP
  COOL_DRY
  REFRIGERATED
  FROZEN
}

model Batch {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  batchNumber  String
  mfgDate      DateTime?
  expiryDate   DateTime
  quantity     Int
  mrp          Decimal
  purchaseRate Decimal
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  // The GRN line that received this batch. Nullable for batches created before
  // this link existed; backfilled by tuple match. Lets a GRN edit find the exact
  // batch it created without the fragile (product+batchNumber+expiry+supplier) match.
  grnItemId    String?
  grnItem      GRNItem? @relation(fields: [grnItemId], references: [id])
  createdAt    DateTime @default(now())

  @@index([grnItemId])
}

// ── Suppliers ─────────────────────────────────────────────────
model Supplier {
  id                  String           @id @default(cuid())
  name                String
  contactPerson       String
  phone               String
  email               String
  gstin               String
  drugLicense         String
  address             String
  paymentTerms        PaymentTerms
  bankDetails         String?
  isActive            Boolean          @default(true)
  // Money WE OWE this supplier — increases on GRN (received goods on credit), decreases on payment or ADJUST debit note
  currentOutstanding  Decimal          @default(0)
  whatsappOptIn       Boolean          @default(true)  // supplier-level consent for low-stock WhatsApp alerts
  whatsappNumber      String?          // override of `phone` if WhatsApp lives on a different number
  branchId            String?
  branch              Branch?          @relation(fields: [branchId], references: [id])
  batches             Batch[]
  purchaseOrders      PurchaseOrder[]
  grns                GRN[]
  purchaseReturns     PurchaseReturn[]
  payments            SupplierPayment[]
  activities          SupplierActivity[]
  preferredForProducts Product[]       @relation("ProductPreferredSupplier")
}

enum PaymentTerms {
  NET_30
  NET_45
  NET_60
}

// ── Supplier Activity log ────────────────────────────────────
// Audit trail of interactions with a supplier — calls, WhatsApp, emails,
// free-text notes, and future-dated reminders. Single table with a `type`
// discriminator; field requirements vary by type (enforced in the service).
enum SupplierActivityType {
  CALL
  WHATSAPP
  EMAIL
  NOTE
  REMINDER
}

enum SupplierActivityStatus {
  PENDING
  DONE
  CANCELLED
}

model SupplierActivity {
  id          String                   @id @default(cuid())
  supplierId  String
  supplier    Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        SupplierActivityType
  // Free-text body. Required for CALL/WHATSAPP/EMAIL/NOTE; optional for REMINDER.
  notes       String?
  // Short label, required for REMINDER (e.g. "Follow up on June invoice").
  title       String?
  // When the past interaction happened (CALL/WHATSAPP/EMAIL/NOTE).
  occurredAt  DateTime?
  // When the future reminder is due (REMINDER only).
  dueAt       DateTime?
  // REMINDER lifecycle. Null/ignored for other types.
  status      SupplierActivityStatus?  @default(PENDING)
  // Optional context: who at the supplier's side.
  contactName String?
  // EMAIL subject line only.
  subject     String?

  createdById String
  createdBy   User                     @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?                  @relation(fields: [branchId], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([supplierId, createdAt])
  @@index([supplierId, type])
}

// Mirrors SupplierActivity for the customer side — same CALL/WHATSAPP/EMAIL/
// NOTE/REMINDER discriminator + REMINDER lifecycle. Coexists with
// CustomerReminder (which models a separate monthly-recurring follow-up
// system); this table is the ad-hoc interaction log.
enum CustomerActivityType {
  CALL
  WHATSAPP
  EMAIL
  NOTE
  REMINDER
}

enum CustomerActivityStatus {
  PENDING
  DONE
  CANCELLED
}

model CustomerActivity {
  id          String                   @id @default(cuid())
  customerId  String
  customer    Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        CustomerActivityType
  notes       String?
  title       String?
  occurredAt  DateTime?
  dueAt       DateTime?
  status      CustomerActivityStatus?  @default(PENDING)
  contactName String?
  subject     String?

  createdById String
  createdBy   User                     @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?                  @relation(fields: [branchId], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([customerId, createdAt])
  @@index([customerId, type])
}

// ── Doctors ───────────────────────────────────────────────────
model Doctor {
  id             String    @id @default(cuid())
  name           String
  specialization String
  phone          String
  regNumber      String?
  email          String?
  address        String?
  isActive       Boolean   @default(true)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  createdAt      DateTime  @default(now())
  invoices       Invoice[]
}

// ── Invoices ──────────────────────────────────────────────────
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  type            InvoiceType
  billingType     BillingType
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  customerName    String
  doctorId        String?
  doctor          Doctor?       @relation(fields: [doctorId], references: [id])
  doctorName      String?
  salespersonId   String?
  salesperson     User?         @relation("SalespersonInvoices", fields: [salespersonId], references: [id])
  salespersonName String?
  items           InvoiceItem[]
  subtotal        Decimal
  productDiscount Decimal       @default(0)
  taxableAmount   Decimal
  cgst            Decimal
  sgst            Decimal
  igst            Decimal       @default(0)
  deliveryCharge  Decimal       @default(0)
  roundOff        Decimal       @default(0)
  grandTotal      Decimal
  paymentMode     PaymentMode
  paymentDetails  Json?
  dueDate         DateTime?     // credit-sale payment due date (required for CREDIT at the UI)
  status          InvoiceStatus
  amountPaid      Decimal
  changeReturned  Decimal       @default(0)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], name: "UserInvoices")
  createdAt       DateTime      @default(now())
  creditNotes     CreditNote[]
  payments        Payment[]
  refunds         Refund[]
  paymentLinks    PaymentLink[]
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  editAudits      InvoiceEditAudit[]
  delivery        DeliveryTracking?

  @@index([leadId])  // declared to match the index created in 20260518100000_add_lead_module
}

model InvoiceEditAudit {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  editedById  String
  editedBy    User     @relation("InvoiceEdits", fields: [editedById], references: [id])
  editedAt    DateTime @default(now())
  branchId    String?
  before      Json
  after       Json

  @@index([invoiceId])
  @@index([editedAt])
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  productId       String
  productName     String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  mrp             Decimal
  rate            Decimal
  discountPercent Decimal
  gstPercent      Decimal
  amount          Decimal
}

enum InvoiceType {
  INVOICE
  QUOTATION
}

enum BillingType {
  RETAIL
  WHOLESALE
}

enum PaymentMode {
  CASH
  CARD
  UPI
  CREDIT
  SPLIT
}

enum InvoiceStatus {
  DRAFT
  PAID
  UNPAID
  PARTIAL
  RETURNED
  CANCELLED
}

// ── Delivery Tracking ─────────────────────────────────────────
// Created when the "Courier" toggle is enabled on an invoice. Snapshots the
// invoice's customer + order details so the delivery desk has everything it
// needs without re-joining billing. The `events` relation is the ordered
// status timeline (Booked → … → Delivered/Returned) shown on the tracking page.
model DeliveryTracking {
  id              String          @id @default(cuid())
  invoiceId       String          @unique
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Snapshot fields — carried from the invoice at toggle time so the delivery
  // record is self-contained even if the invoice is later edited.
  invoiceNumber   String
  customerName    String
  mobileNumber    String?
  deliveryAddress String?
  orderSummary    String?         // human-readable item summary (e.g. "Paracetamol ×2, …")
  // Courier fields — filled manually or auto-populated from OCR of the receipt.
  courierName     String?
  trackingId      String?
  dispatchDate    DateTime?
  receiptName     String?         // original filename of the uploaded receipt
  ocrText         String?         // raw OCR text captured from the receipt (for audit)
  status          DeliveryStatus  @default(BOOKED)
  deliveredAt     DateTime?
  // Carrier (AfterShip) sync metadata. `carrierSlug` is the resolved AfterShip
  // courier slug (e.g. "dtdc"); `lastSyncedAt` is the last successful live poll.
  carrierSlug     String?
  lastSyncedAt    DateTime?
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id])
  createdById     String
  createdBy       User            @relation("UserDeliveries", fields: [createdById], references: [id])
  events          DeliveryEvent[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([branchId])
  @@index([trackingId])
}

model DeliveryEvent {
  id          String           @id @default(cuid())
  deliveryId  String
  delivery    DeliveryTracking @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status      DeliveryStatus
  location    String?
  note        String?
  occurredAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  // Stable hash of a carrier (AfterShip) checkpoint — lets repeated syncs skip
  // checkpoints already imported. NULL for manually-added events (Postgres
  // allows many NULLs under a unique index, so manual events never collide).
  externalId  String?

  @@unique([deliveryId, externalId])
  @@index([deliveryId])
}

enum DeliveryStatus {
  BOOKED
  DISPATCHED
  IN_TRANSIT
  ARRIVED_AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

// ── Purchase Orders ───────────────────────────────────────────
model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  date             DateTime            @default(now())
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id])
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  supplierName     String
  items            PurchaseOrderItem[]
  totalAmount      Decimal
  status           POStatus
  expectedDelivery DateTime?
  createdBy        String              // Simplifying for this relation, could link to User
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String
  productName      String
  requiredQty      Int
  lastPurchaseRate Decimal
  expectedRate     Decimal
  receivedQty      Int           @default(0)
  remarks          String?
}

enum POStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
  CANCELLED
}

// ── GRN ───────────────────────────────────────────────────────
model GRN {
  id                    String    @id @default(cuid())
  grnNumber             String    @unique
  date                  DateTime  @default(now())
  branchId              String?
  branch                Branch?   @relation(fields: [branchId], references: [id])
  poId                  String?
  supplierId            String
  supplier              Supplier  @relation(fields: [supplierId], references: [id])
  supplierName          String
  supplierInvoiceNo     String
  supplierInvoiceDate   DateTime
  supplierInvoiceAmount Decimal
  items                 GRNItem[]
  totalAmount           Decimal
  status                GRNStatus
  // Money already paid to the supplier against this GRN's invoice. Outstanding
  // contribution = supplierInvoiceAmount - amountPaid (mirrors invoice paid/grandTotal).
  amountPaid            Decimal   @default(0)
  // Derived from amountPaid vs supplierInvoiceAmount. Distinct from the GRNStatus
  // receiving workflow (DRAFT/RECEIVED/VERIFIED).
  paymentStatus         GrnPaymentStatus @default(UNPAID)
  // True if this GRN was created to receive replacement goods (does NOT add to supplier outstanding)
  isReplacement         Boolean   @default(false)
  purchaseReturns       PurchaseReturn[]
  payments              SupplierPayment[]
  editLogs              GrnEditLog[]
}

// Payment-state of a GRN's supplier invoice. Separate from the GRNStatus
// receiving workflow — a GRN can be RECEIVED but still UNPAID.
enum GrnPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

// Audit trail of GRN edits. Mirrors InvoiceEditAudit but stores the editor as
// plain strings (like StockAdjustmentLog) to avoid a User back-relation.
model GrnEditLog {
  id           String   @id @default(cuid())
  grnId        String
  grn          GRN      @relation(fields: [grnId], references: [id], onDelete: Cascade)
  editedById   String
  editedByName String
  branchId     String?
  before       Json
  after        Json
  editedAt     DateTime @default(now())

  @@index([grnId])
  @@index([editedAt])
}

model GRNItem {
  id           String   @id @default(cuid())
  grnId        String
  grn          GRN      @relation(fields: [grnId], references: [id])
  productId    String
  productName  String
  orderedQty   Int
  receivedQty  Int
  freeQty      Int      @default(0)
  batchNumber  String
  mfgDate      DateTime?
  expiryDate   DateTime
  purchaseRate Decimal
  mrp          Decimal
  damageQty    Int      @default(0)
  batches      Batch[]
}

enum GRNStatus {
  DRAFT
  RECEIVED
  VERIFIED
}

// ── Expenses ──────────────────────────────────────────────────
model Expense {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  category     String
  description  String
  amount       Decimal
  paymentMode  String
  receiptImage String?
}

// ── Credit Notes (Sales Returns from Customers) ───────────────
model CreditNote {
  id              String           @id @default(cuid())
  creditNoteNo    String           @unique
  date            DateTime         @default(now())
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  invoiceNumber   String
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerName    String
  reason          String
  items           CreditNoteItem[]
  subtotal        Decimal
  cgst            Decimal          @default(0)
  sgst            Decimal          @default(0)
  igst            Decimal          @default(0)
  totalAmount     Decimal
  settlementMode  SettlementMode   @default(REFUND)
  // Lifecycle status separate from settlement. PENDING_REVIEW = staff hasn't
  // physically inspected the returned goods yet, no inventory/balance effects
  // have fired. APPROVED = inspection passed, side effects executed. REJECTED
  // = goods didn't match the claimed reason, CN is kept as historical record.
  status          CreditNoteStatus @default(PENDING_REVIEW)
  reviewedById    String?
  reviewedBy      User?            @relation("CreditNoteReviews", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  // Free-text inspection note. Optional on approve (reviewer may not need to
  // explain a clean acceptance); required on reject so the reason is auditable.
  reviewNote      String?
  // Set when the credit note is fully settled — i.e. customer has received
  // the refund (REFUND), the credit has been applied (CREDIT — auto-set on
  // approve), or the replacement invoice has been issued (REPLACEMENT).
  // Null = pending settlement. Distinct from `status`: a CN can be APPROVED
  // but still have settledAt = null (e.g. REFUND mode pending cash payout).
  settledAt       DateTime?
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
  refund          Refund?
}

model CreditNoteItem {
  id              String     @id @default(cuid())
  creditNoteId    String
  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id])
  productId       String
  productName     String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  returnedQty     Int
  rate            Decimal
  gstPercent      Decimal
  amount          Decimal
}

enum SettlementMode {
  REFUND
  CREDIT
  REPLACEMENT
}

// ── Customer Refunds ──────────────────────────────────────────
// A real cash/bank payout to a customer, created when a REFUND-settled credit
// note is approved. Makes the money-out movement visible & reconcilable in the
// Cash Book (cash mode), the customer ledger (a debit that offsets the credit
// note), and is the audit trail for "we paid the customer back". One per CN.
model Refund {
  id           String     @id @default(cuid())
  refundNumber String     @unique
  creditNoteId String     @unique
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id])
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  invoiceId    String?
  invoice      Invoice?   @relation(fields: [invoiceId], references: [id])
  amount       Decimal
  paymentMode  String     // CASH | CARD | UPI — how the money left (drives Cash Book inclusion)
  notes        String?
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  createdById  String
  createdAt    DateTime   @default(now())
  @@index([customerId])
  @@index([createdAt])
}

enum CreditNoteStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ── Debit Notes / Purchase Returns (to Suppliers) ─────────────
model PurchaseReturn {
  id                String                     @id @default(cuid())
  debitNoteNo       String                     @unique
  date              DateTime                   @default(now())
  branchId          String?
  branch            Branch?                    @relation(fields: [branchId], references: [id])
  grnId             String?
  grn               GRN?                       @relation(fields: [grnId], references: [id])
  supplierId        String
  supplier          Supplier                   @relation(fields: [supplierId], references: [id])
  supplierName      String
  reason            String
  items             PurchaseReturnItem[]
  subtotal          Decimal
  cgst              Decimal                    @default(0)
  sgst              Decimal                    @default(0)
  igst              Decimal                    @default(0)
  totalAmount       Decimal
  status            PurchaseReturnStatus       @default(DRAFT)
  settlementMode    PurchaseReturnSettlement   @default(REFUND)
  replacementGrnId  String?
  notes             String?
  createdById       String
  createdAt         DateTime                   @default(now())

  // Set when an admin reversal has put back the wrongly-deducted stock for
  // this short-delivery debit note. Prevents the reverse endpoint from
  // adding the same qty twice on repeated calls.
  stockReversedAt   DateTime?
}

enum PurchaseReturnSettlement {
  REFUND
  REPLACEMENT
  ADJUST
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  productId        String
  productName      String
  batchId          String
  batchNumber      String
  expiryDate       DateTime
  returnedQty      Int
  purchaseRate     Decimal
  gstPercent       Decimal
  amount           Decimal
}

enum PurchaseReturnStatus {
  DRAFT
  SENT
  ACCEPTED
  SETTLED
}

// ── Audit Log ─────────────────────────────────────────────────
model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  module      String
  action      String
  entity      String
  entityId    String?
  entityLabel String?
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// ── Global Settings ───────────────────────────────────────────
model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Document Numbering ────────────────────────────────────────
// Atomic counter per (docType, branchScope, financialYear). Concurrent
// creators serialize on the same row via INSERT...ON CONFLICT DO UPDATE,
// which guarantees no duplicate numbers under load.
model DocumentSequence {
  id            String   @id @default(cuid())
  key           String   @unique // "PO:<branchId|GLOBAL>:<FY>"
  docType       String   // PO | GRN | DN
  branchId      String?
  financialYear String   // e.g. "26-27"
  counter       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([docType, branchId, financialYear])
}

// ── Discount Rules ────────────────────────────────────────────
/// @deprecated — no longer wired to billing. Table stays (empty in production)
/// in case a future schema-aware rebuild reuses it; the current shape is
/// insufficient (no FK to Product/Category/Customer, `applicableTo` is free
/// text). Backend CRUD endpoints and the Settings UI tab were removed
/// 2026-05-20.
model DiscountRule {
  id           String       @id @default(cuid())
  name         String
  type         DiscountType @default(PERCENTAGE)
  value        Decimal
  applicableTo String?
  validFrom    DateTime?
  validTo      DateTime?
  isActive     Boolean      @default(true)
  branchId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

// ── Quotations ────────────────────────────────────────────────
model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  date            DateTime        @default(now())
  branchId        String?
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String?
  items           QuotationItem[]
  subtotal        Decimal         @default(0)
  cgst            Decimal         @default(0)
  sgst            Decimal         @default(0)
  deliveryCharge  Decimal         @default(0)
  total           Decimal
  validUntil      DateTime?
  notes           String?
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
  @@index([leadId])  // declared to match the index created in 20260518100000_add_lead_module
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?
  productName     String
  batchId         String?
  batchNumber     String?
  quantity        Int
  mrp             Decimal   @default(0)
  rate            Decimal
  discountPercent Decimal   @default(0)
  gstPercent      Decimal   @default(0)
  amount          Decimal
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

// ── Payment Records ───────────────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoiceId       String?       // null = customer-level lump payment (allocated below)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  amount          Decimal
  paymentMode     String        // CASH | CARD | UPI | CHEQUE | NEFT_UPI
  referenceNumber String?       // payment gateway txn id (e.g. Razorpay pay_xxx), cheque #, UTR
  notes           String?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdAt       DateTime      @default(now())
  @@index([referenceNumber])    // fast webhook reconciliation lookup
}

// ── Supplier Payment Records ──────────────────────────────────
// Money WE PAY a supplier — the credit side of the supplier ledger. Mirrors the
// customer-side Payment model. grnId links the payment to a specific received
// invoice; null = lump payment allocated FIFO across the supplier's open GRNs.
model SupplierPayment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique
  supplierId      String
  supplier        Supplier      @relation(fields: [supplierId], references: [id])
  grnId           String?       // null = supplier-level lump payment (allocated FIFO)
  grn             GRN?          @relation(fields: [grnId], references: [id])
  amount          Decimal
  paymentMode     String        // CASH | CHEQUE | NEFT_UPI | UPI | CARD
  referenceNumber String?       // cheque #, UTR, txn ref
  notes           String?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdAt       DateTime      @default(now())
  @@index([supplierId])
  @@index([grnId])
}

// ── Notifications ─────────────────────────────────────────────
model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  actionUrl     String?
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id])
  snoozedUntil  DateTime?
  // Stamped when the user takes the corrective action (e.g. records payment
  // for a Payment Due alert). Independent of isRead so we can show audit info.
  resolvedAt    DateTime?
  resolvedById  String?
  // Snapshot of the underlying entity's state at create time, e.g.
  // { totalStock: 5, minStock: 20 } for a Low Stock alert. Used by the
  // scheduler's escalation check — only re-fire when the situation has worsened.
  entityState   Json?
  createdAt     DateTime         @default(now())

  @@index([branchId, isRead, snoozedUntil])
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  PAYMENT_DUE
  SYSTEM
  APPROVAL
}

// ── Customer Reminders ────────────────────────────────────────
model CustomerReminder {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dayOfMonth   Int              // 1-31: repeat on this day each month
  title        String
  notes        String?
  // One-off follow-up requested by the customer ("call me back on X"). When set,
  // it overrides the monthly dayOfMonth schedule until the next contact is logged.
  // null = plain monthly cycle.
  followUpDate DateTime?
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  contacts     ReminderContact[]
}

model ReminderContact {
  id           String              @id @default(cuid())
  reminderId   String
  reminder     CustomerReminder    @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  contactedAt  DateTime            @default(now())
  status       ReminderContactStatus
  notes        String?
  // The follow-up date the customer requested at this specific contact (audit
  // trail). The active follow-up lives on CustomerReminder.followUpDate.
  followUpDate DateTime?
}

enum ReminderContactStatus {
  TALKED
  NOT_RESPONDED
  DENIED
  NEED_TO_TALK
  SCHEDULED
  // Written by ReminderDueNotificationListener after it auto-sends a
  // monthly WhatsApp to the customer. Staff sees the entry in the
  // RemindersPage contact log so they know not to also call.
  WHATSAPP_AUTO_SENT
}

// ── Approval Requests ─────────────────────────────────────────
model ApprovalRequest {
  id            String              @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus      @default(PENDING)
  requestedById String
  requestedBy   User                @relation("ApprovalRequests", fields: [requestedById], references: [id])
  requestedAt   DateTime            @default(now())
  reviewedById  String?
  reviewedBy    User?               @relation("ApprovalReviews", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  payload       Json
  refId         String?             // id of the draft invoice / customer / return after creation
  branchId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum ApprovalType {
  NEW_CUSTOMER
  CREDIT_BILL
  SALES_RETURN
  PURCHASE_RETURN
  INVENTORY_ADJUSTMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────
// ── CRM: Leads / Contacts / Companies ────────────────────────
// ─────────────────────────────────────────────────────────────

enum LeadStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadStatus {
  OPEN
  CLOSED
}

enum LeadTouchStatus {
  TOUCHED
  UNTOUCHED
}

enum LeadSource {
  MANUAL
  INDIAMART
  REFERRAL
  WEBSITE
  WHATSAPP
  CALL
  EMAIL
  OTHER
}

enum LeadPipeline {
  SALES
  PROCUREMENT
  SUPPORT
}

// IndiaMART QUERY_TYPE: W=Direct Enquiry, B=Buy-Lead, P=PNS Call,
// BIZ=Catalog-view, WA=WhatsApp Enquiry. Stored verbatim from upstream.
enum IndiamartQueryType {
  W
  B
  P
  BIZ
  WA
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum LeadActivityType {
  CALL
  WHATSAPP
  EMAIL
  NOTE
  REMINDER
}

enum LeadActivityStatus {
  PENDING
  DONE
  CANCELLED
}

// Companies are lightweight — just enough to group contacts/leads.
// Not the same thing as Customer (which represents an actual billing party).
model Company {
  id        String    @id @default(cuid())
  name      String
  website   String?
  industry  String?
  address   String?
  city      String?
  state     String?
  country   String?
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  contacts  Contact[]
  leads     Lead[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([branchId, name])
}

// Contact = a person we might do business with. Belongs to a branch, may
// belong to a Company, may eventually be PROMOTED into a real Customer
// (when their lead wins). One-to-one promotion link via promotedCustomerId.
model Contact {
  id                  String        @id @default(cuid())
  firstName           String
  lastName            String?
  phoneCountryCode    String        @default("+91")
  phone               String
  email               String?
  jobTitle            String?
  companyId           String?
  company             Company?      @relation(fields: [companyId], references: [id])
  address             String?
  city                String?
  state               String?
  country             String?
  countryIso          String?
  source              LeadSource    @default(MANUAL)
  status              ContactStatus @default(ACTIVE)
  ownerUserId         String
  ownerUser           User          @relation("ContactOwner", fields: [ownerUserId], references: [id])
  branchId            String
  branch              Branch        @relation(fields: [branchId], references: [id])
  promotedCustomerId  String?       @unique
  promotedCustomer    Customer?     @relation("ContactPromotion", fields: [promotedCustomerId], references: [id])
  leads               Lead[]
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([branchId, phone])
  @@index([branchId, email])
}

// Lead = a sales opportunity. Always anchored to a Contact (the person);
// optionally to a Company. IndiaMART-sourced leads keep their original
// UNIQUE_QUERY_ID in externalQueryId for idempotency.
model Lead {
  id                  String          @id @default(cuid())
  leadNumber          String          @unique
  title               String
  description         String?
  source              LeadSource      @default(MANUAL)
  pipeline            LeadPipeline    @default(SALES)
  stage               LeadStage       @default(LEAD)
  status              LeadStatus      @default(OPEN)
  touchStatus         LeadTouchStatus @default(UNTOUCHED)
  score               Int             @default(50)
  value               Decimal         @default(0)
  currency            String          @default("INR")
  expectedCloseDate   DateTime?
  validUntil          DateTime?

  contactId           String
  contact             Contact         @relation(fields: [contactId], references: [id])
  companyId           String?
  company             Company?        @relation(fields: [companyId], references: [id])

  assignedToUserId    String
  assignedToUser      User            @relation("LeadAssignee", fields: [assignedToUserId], references: [id])

  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id])

  // IndiaMART payload bits (only populated when source=INDIAMART).
  // externalQueryId is the dedupe key — see indiamart-sync.service.
  externalQueryId     String?            @unique
  externalQueryType   IndiamartQueryType?
  externalQueryTime   DateTime?
  externalMessage     String?
  externalProductName String?
  externalCategory    String?
  externalCity        String?
  externalState       String?
  externalCountryIso  String?
  externalRaw         Json?

  activities          LeadActivity[]
  quotations          Quotation[]
  invoices            Invoice[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([branchId, stage, status])
  @@index([assignedToUserId])
  @@index([source, createdAt])
  @@index([touchStatus])
  @@index([contactId])
}

// Mirrors CustomerActivity/SupplierActivity exactly — same five types,
// same reminder lifecycle. Kept as its own table so list/filter queries
// stay scoped per-lead without joining across noisy parent tables.
model LeadActivity {
  id          String              @id @default(cuid())
  leadId      String
  lead        Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  notes       String?
  title       String?
  occurredAt  DateTime?
  dueAt       DateTime?
  status      LeadActivityStatus? @default(PENDING)
  contactName String?
  subject     String?

  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?             @relation(fields: [branchId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([leadId, createdAt])
  @@index([leadId, type])
}

// ─────────────────────────────────────────────────────────────
// ── Integrations (IndiaMART Pull API v2 and friends) ─────────
// ─────────────────────────────────────────────────────────────

enum IntegrationProvider {
  INDIAMART
}

enum SyncJobStatus {
  RUNNING
  SUCCESS
  FAILED
  RATE_LIMITED
  NO_NEW_LEADS
}

// Stores the encrypted API key per (provider, branch) and tracks the
// rolling watermark used by Strategy-2 (overlap window = lastEnd − 5 min).
model IntegrationCredential {
  id                    String              @id @default(cuid())
  provider              IntegrationProvider
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  // Push API: the high-entropy URL-path secret. IndiaMART POSTs to
  // `<APP_PUBLIC_URL>/api/v1/integrations/indiamart/webhook/<webhookToken>`
  // and we use the token to route the incoming lead to the right branch.
  // Stored as plaintext because the token IS the URL the seller pastes
  // into IndiaMART's panel — protecting it inside our DB doesn't help
  // once the URL leaves our system.
  webhookToken          String?             @unique
  // Pull API (legacy) — kept nullable for backward compatibility while we
  // migrate to Push. New rows leave these null.
  apiKeyCiphertext      String?             // AES-256-GCM ciphertext
  apiKeyIv              String?             // base64 IV
  apiKeyTag             String?             // base64 auth tag
  isActive              Boolean             @default(true)
  lastVerifiedAt        DateTime?
  lastSuccessfulEndTime DateTime?           // legacy: Pull watermark; Push uses lastVerifiedAt for "last received"
  cooldownUntil         DateTime?           // legacy: Pull rate-limit cooldown; unused for Push
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([provider, branchId])
  @@index([isActive, provider])
}

// Audit log of every pull, including raw error responses. Used by the
// admin "Sync Jobs" screen to show last 50 attempts + replay one if needed.
model IntegrationSyncJob {
  id               String              @id @default(cuid())
  provider         IntegrationProvider
  branchId         String
  branch           Branch              @relation(fields: [branchId], references: [id])
  startTime        DateTime
  endTime          DateTime
  status           SyncJobStatus
  totalRecords     Int                 @default(0)
  newLeadsCount    Int                 @default(0)
  dupeSkippedCount Int                 @default(0)
  errorCode        Int?
  errorMessage     String?
  rawRequestUrl    String?
  rawResponseSize  Int?
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?

  @@index([branchId, provider, startedAt])
  @@index([status])
}

// ── Payment Gateway QR Codes ──────────────────────────────────
// One row per QR generated against an invoice. The provider's QR (Razorpay
// `qr_xxx`) does NOT expire by default (we omit `close_by`) — the customer
// may scan and pay days/weeks/months later. `qr_code.credited` webhook on
// the provider side flips status → PAID + writes the Payment row.
model PaymentLink {
  id              String              @id @default(cuid())
  invoiceId       String
  invoice         Invoice             @relation(fields: [invoiceId], references: [id])
  provider        PaymentProvider
  providerQrId    String              @unique  // e.g. Razorpay qr_xxx
  shortUrl        String              // provider-hosted short URL (Razorpay short_url)
  qrImageUrl      String              // provider-hosted QR image URL
  amount          Decimal             // amount in ₹ (kept as Decimal, paise conversion at API edge)
  paidAmount      Decimal             @default(0)
  status          PaymentLinkStatus   @default(CREATED)
  closedAt        DateTime?
  paidAt          DateTime?
  branchId        String?
  branch          Branch?             @relation(fields: [branchId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  @@index([invoiceId, status])
  @@index([branchId])
}

enum PaymentProvider {
  RAZORPAY
  CASHFREE
}

enum PaymentLinkStatus {
  CREATED   // QR generated, not yet delivered to customer
  SENT      // delivered via WhatsApp
  PAID      // payment captured via webhook
  CLOSED    // closed manually (e.g. partial cash collection regenerated a new QR)
  EXPIRED   // provider-side expiry, only if we ever set close_by
}

// ── WhatsApp Messages (audit + retry) ─────────────────────────
// One row per outbound message attempt via Meta Cloud API. Holds the Meta
// wamid once we get one back, plus delivery status (DELIVERED / READ /
// FAILED) updated by webhook. Failed rows are retried by a cron sweeper.
model WhatsAppMessage {
  id                  String                @id @default(cuid())
  to                  String                // E.164 without +, e.g. 919876543210
  templateName        String
  messageBody         String?               // rendered text snapshot for audit
  mediaUrl            String?               // PDF URL passed as document header
  // Serialized template vars (the input to the template builder fn). The retry
  // sweeper uses this to rebuild the Meta template payload without re-firing
  // the source event — necessary for non-invoice senders (low-stock supplier,
  // sale reminder, etc.) where re-firing the trigger event would risk
  // duplicating the underlying notification.
  templateVars        Json?
  providerMessageId   String?               @unique  // Meta wamid (e.g. wamid.HBgM...)
  status              WhatsAppMessageStatus @default(QUEUED)
  errorCode           String?
  errorMessage        String?
  attempts            Int                   @default(0)
  lastAttemptAt       DateTime?
  relatedEntityType   String?               // "invoice" | "quotation" | "credit_note" | "supplier_low_stock" | ...
  relatedEntityId     String?
  branchId            String?
  branch              Branch?               @relation(fields: [branchId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  @@index([relatedEntityType, relatedEntityId])
  @@index([status, attempts])
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

// ── Webhook Events (idempotency + audit) ──────────────────────
// First-write-wins dedup for Razorpay / Meta webhook deliveries. Provider
// retries on non-2xx for up to 24h, so we MUST return 200 once recorded.
// `providerEventId` is the dedup key (Razorpay X-Razorpay-Event-Id header
// or Meta payload.id).
model WebhookEvent {
  id                String              @id @default(cuid())
  provider          String              // "META" | "RAZORPAY"
  eventType         String              // "qr_code.credited" | "messages" | "message_template_status_update" | ...
  providerEventId   String              @unique
  payloadJson       Json
  signatureValid    Boolean
  status            WebhookEventStatus  @default(RECEIVED)
  processedAt       DateTime?
  errorMessage      String?
  createdAt         DateTime            @default(now())
  @@index([provider, eventType])
  @@index([status])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  DUPLICATE
  INVALID_SIGNATURE
}

// ── Document numbering config ─────────────────────────────────
// Per-(branch, docType) format settings consumed by DocumentNumberingService.
// branchId NULL applies as a global default. Absence of a row → service falls
// back to the hardcoded `${docType}/${fy}/${padded5}` format (zero-risk
// rollout). State (the actual counter) stays on `DocumentSequence`.
model NumberingConfig {
  id        String   @id @default(cuid())
  branchId  String?
  docType   String   // 'INV' | 'QTN' | 'CN' | 'DN' | 'PO' | 'GRN'
  template  String   // e.g. "HS/INV/{FY}/{NN}" — supports literals + {FY} + {NN}
  fyFormat  String   @default("YY-YY") // YY-YY | YYYY-YY | YY | YYYY
  padding   Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  @@unique([branchId, docType])
  @@index([docType])
}

// ── Backups ───────────────────────────────────────────────────
// Manual + scheduled database snapshots, serialized as JSONL via Prisma and
// stored in Cloudflare R2 (private). See BackupService for the run pipeline.
model Backup {
  id           String         @id @default(cuid())
  filename     String         // human-readable file name, e.g. "pbims-2026-05-20-1430.jsonl.gz"
  r2Key        String         // object key in the R2 bucket, e.g. "backups/<cuid>.jsonl.gz"
  sizeBytes    Int            @default(0)
  rowCount     Int            @default(0) // total records across all backed-up tables
  trigger      BackupTrigger
  status       BackupStatus
  errorMessage String?
  createdById  String?        // null for SCHEDULED runs
  createdBy    User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?
  @@index([createdAt])
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
}

enum BackupStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}
