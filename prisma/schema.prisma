generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's connection pooler runs in transaction mode and doesn't hold
  // session-level advisory locks. Prisma uses an advisory lock during
  // `migrate deploy`/`migrate dev`, so we point those commands at the
  // non-pooler hostname via DIRECT_URL. Runtime traffic still uses the
  // pooled DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ── Branch / Location ─────────────────────────────────────────
model Branch {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique  // short code e.g. "HQ", "BR1"
  address     String?
  phone       String?
  email       String?
  gstin       String?
  drugLicense String?
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  users           User[]
  invoices        Invoice[]
  expenses        Expense[]
  purchaseOrders  PurchaseOrder[]
  grns            GRN[]
  creditNotes     CreditNote[]
  purchaseReturns PurchaseReturn[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  doctors         Doctor[]
  prescriptions   Prescription[]
  notifications   Notification[]
  payments        Payment[]
  reminders       CustomerReminder[]
  categories      Category[]
  supplierActivities SupplierActivity[]
  customerActivities CustomerActivity[]
  leads              Lead[]
  contacts           Contact[]
  companies          Company[]
  leadActivities     LeadActivity[]
  integrationCredentials IntegrationCredential[]
  integrationSyncJobs    IntegrationSyncJob[]
}

// ── Users & Auth ──────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String
  password       String    // bcrypt hashed
  role           Role      @default(PHARMACIST)
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  commissionRate Decimal   @default(0) // % commission for SALESPERSON role
  createdAt      DateTime  @default(now())
  invoices             Invoice[]          @relation("UserInvoices")
  salespersonInvoices  Invoice[]          @relation("SalespersonInvoices")
  auditLogs            AuditLog[]
  approvalRequests     ApprovalRequest[]  @relation("ApprovalRequests")
  approvalReviews      ApprovalRequest[]  @relation("ApprovalReviews")
  supplierActivities   SupplierActivity[]
  customerActivities   CustomerActivity[]
  sharedFiles          SharedFile[]
  assignedLeads        Lead[]             @relation("LeadAssignee")
  ownedContacts        Contact[]          @relation("ContactOwner")
  leadActivities       LeadActivity[]
  invoiceEdits         InvoiceEditAudit[] @relation("InvoiceEdits")
}

enum Role {
  ADMIN
  PHARMACIST
  INVENTORY_MANAGER
  ACCOUNTANT
  SALESPERSON
}

// ── Customers ─────────────────────────────────────────────────
model Customer {
  id                 String         @id @default(cuid())
  name               String
  phone              String
  alternatePhone     String?
  email              String?
  address            String?
  type               CustomerType   @default(RETAIL)
  doctorRef          String?
  referredBy         String?        // salesperson name
  creditLimit        Decimal        @default(0)
  currentOutstanding Decimal        @default(0)
  loyaltyPoints      Int            @default(0)
  gstin              String?
  dlNumber           String?
  registrationNumber String?   // For DOCTOR type: Medical Council Reg. No.
  notes              String?
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id])
  createdAt          DateTime       @default(now())
  invoices           Invoice[]
  prescriptions      Prescription[]
  creditNotes        CreditNote[]
  quotations         Quotation[]
  payments           Payment[]
  reminders          CustomerReminder[]
  activities         CustomerActivity[]
  promotedFromContact Contact?           @relation("ContactPromotion")
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DOCTOR
}

// ── Shared files ──────────────────────────────────────────────
// Temporary public links for sharing PDFs (invoices, quotations) with
// customers via WhatsApp etc. The id is also the on-disk filename stub;
// expired rows are cleaned up by a daily scheduler and the static-serve
// path 404s once the file is gone.
model SharedFile {
  id          String   @id @default(cuid())
  filename    String   // original filename (for Content-Disposition / display)
  mimeType    String
  sizeBytes   Int
  label       String?  // optional caller-supplied tag, e.g. "INV-123"
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  @@index([expiresAt])
}

// ── Prescriptions ─────────────────────────────────────────────
model Prescription {
  id         String    @id @default(cuid())
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  doctorName String
  imageUrl   String?   // uploaded file path / S3 URL
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  validUntil DateTime?
}

// ── Categories ────────────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?   // hex color for UI badge
  isActive    Boolean   @default(true)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name, branchId])
}

// ── Products & Batches ────────────────────────────────────────
model Product {
  id               String           @id @default(cuid())
  name             String
  genericName      String
  saltComposition  String?
  manufacturer     String
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  subCategory      String?
  packSize         String
  unitOfMeasure    String
  schedule         Schedule         @default(NONE)
  hsnCode          String
  isNarcotic       Boolean          @default(false)
  storageCondition StorageCondition
  mrp              Decimal
  purchaseRate     Decimal
  sellingRate      Decimal
  wholesaleRate    Decimal
  gstRate          Decimal
  minStock         Int
  maxStock         Int
  reorderQty       Int
  rackLocation     String
  barcode          String?
  totalStock       Int              @default(0)
  isActive         Boolean          @default(true)
  branchId         String?
  branch           Branch?          @relation(fields: [branchId], references: [id])
  batches          Batch[]
  alternatives     Product[]        @relation("Alternatives")
  alternativesOf   Product[]        @relation("Alternatives")
  adjustmentLogs   StockAdjustmentLog[]
  createdAt        DateTime         @default(now())

  @@unique([barcode, branchId])
}

model StockAdjustmentLog {
  id            String   @id @default(cuid())
  adjustmentNo  String?
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId       String
  batchNumber   String
  userId        String
  userName      String
  reason        String
  previousQty   Int
  adjustedQty   Int
  diff          Int
  notes         String?
  branchId      String?
  createdAt     DateTime @default(now())
}

enum Schedule {
  NONE
  H
  H1
  X
}

enum StorageCondition {
  ROOM_TEMP
  COOL_DRY
  REFRIGERATED
  FROZEN
}

model Batch {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  batchNumber  String
  mfgDate      DateTime
  expiryDate   DateTime
  quantity     Int
  mrp          Decimal
  purchaseRate Decimal
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  createdAt    DateTime @default(now())
}

// ── Suppliers ─────────────────────────────────────────────────
model Supplier {
  id                  String           @id @default(cuid())
  name                String
  contactPerson       String
  phone               String
  email               String
  gstin               String
  drugLicense         String
  address             String
  paymentTerms        PaymentTerms
  bankDetails         String?
  isActive            Boolean          @default(true)
  // Money WE OWE this supplier — increases on GRN (received goods on credit), decreases on payment or ADJUST debit note
  currentOutstanding  Decimal          @default(0)
  branchId            String?
  branch              Branch?          @relation(fields: [branchId], references: [id])
  batches             Batch[]
  purchaseOrders      PurchaseOrder[]
  grns                GRN[]
  purchaseReturns     PurchaseReturn[]
  activities          SupplierActivity[]
}

enum PaymentTerms {
  NET_30
  NET_45
  NET_60
}

// ── Supplier Activity log ────────────────────────────────────
// Audit trail of interactions with a supplier — calls, WhatsApp, emails,
// free-text notes, and future-dated reminders. Single table with a `type`
// discriminator; field requirements vary by type (enforced in the service).
enum SupplierActivityType {
  CALL
  WHATSAPP
  EMAIL
  NOTE
  REMINDER
}

enum SupplierActivityStatus {
  PENDING
  DONE
  CANCELLED
}

model SupplierActivity {
  id          String                   @id @default(cuid())
  supplierId  String
  supplier    Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type        SupplierActivityType
  // Free-text body. Required for CALL/WHATSAPP/EMAIL/NOTE; optional for REMINDER.
  notes       String?
  // Short label, required for REMINDER (e.g. "Follow up on June invoice").
  title       String?
  // When the past interaction happened (CALL/WHATSAPP/EMAIL/NOTE).
  occurredAt  DateTime?
  // When the future reminder is due (REMINDER only).
  dueAt       DateTime?
  // REMINDER lifecycle. Null/ignored for other types.
  status      SupplierActivityStatus?  @default(PENDING)
  // Optional context: who at the supplier's side.
  contactName String?
  // EMAIL subject line only.
  subject     String?

  createdById String
  createdBy   User                     @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?                  @relation(fields: [branchId], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([supplierId, createdAt])
  @@index([supplierId, type])
}

// Mirrors SupplierActivity for the customer side — same CALL/WHATSAPP/EMAIL/
// NOTE/REMINDER discriminator + REMINDER lifecycle. Coexists with
// CustomerReminder (which models a separate monthly-recurring follow-up
// system); this table is the ad-hoc interaction log.
enum CustomerActivityType {
  CALL
  WHATSAPP
  EMAIL
  NOTE
  REMINDER
}

enum CustomerActivityStatus {
  PENDING
  DONE
  CANCELLED
}

model CustomerActivity {
  id          String                   @id @default(cuid())
  customerId  String
  customer    Customer                 @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type        CustomerActivityType
  notes       String?
  title       String?
  occurredAt  DateTime?
  dueAt       DateTime?
  status      CustomerActivityStatus?  @default(PENDING)
  contactName String?
  subject     String?

  createdById String
  createdBy   User                     @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?                  @relation(fields: [branchId], references: [id])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([customerId, createdAt])
  @@index([customerId, type])
}

// ── Doctors ───────────────────────────────────────────────────
model Doctor {
  id             String    @id @default(cuid())
  name           String
  specialization String
  phone          String
  regNumber      String?
  email          String?
  address        String?
  isActive       Boolean   @default(true)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  createdAt      DateTime  @default(now())
  invoices       Invoice[]
}

// ── Invoices ──────────────────────────────────────────────────
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  type            InvoiceType
  billingType     BillingType
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  customerName    String
  doctorId        String?
  doctor          Doctor?       @relation(fields: [doctorId], references: [id])
  doctorName      String?
  salespersonId   String?
  salesperson     User?         @relation("SalespersonInvoices", fields: [salespersonId], references: [id])
  salespersonName String?
  items           InvoiceItem[]
  subtotal        Decimal
  productDiscount Decimal       @default(0)
  taxableAmount   Decimal
  cgst            Decimal
  sgst            Decimal
  igst            Decimal       @default(0)
  deliveryCharge  Decimal       @default(0)
  roundOff        Decimal       @default(0)
  grandTotal      Decimal
  paymentMode     PaymentMode
  paymentDetails  Json?
  status          InvoiceStatus
  amountPaid      Decimal
  changeReturned  Decimal       @default(0)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], name: "UserInvoices")
  createdAt       DateTime      @default(now())
  creditNotes     CreditNote[]
  payments        Payment[]
  leadId          String?
  lead            Lead?         @relation(fields: [leadId], references: [id])
  editAudits      InvoiceEditAudit[]
}

model InvoiceEditAudit {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  editedById  String
  editedBy    User     @relation("InvoiceEdits", fields: [editedById], references: [id])
  editedAt    DateTime @default(now())
  branchId    String?
  before      Json
  after       Json

  @@index([invoiceId])
  @@index([editedAt])
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  productId       String
  productName     String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  mrp             Decimal
  rate            Decimal
  discountPercent Decimal
  gstPercent      Decimal
  amount          Decimal
}

enum InvoiceType {
  INVOICE
  QUOTATION
}

enum BillingType {
  RETAIL
  WHOLESALE
}

enum PaymentMode {
  CASH
  CARD
  UPI
  CREDIT
  SPLIT
}

enum InvoiceStatus {
  DRAFT
  PAID
  UNPAID
  PARTIAL
  RETURNED
  CANCELLED
}

// ── Purchase Orders ───────────────────────────────────────────
model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  date             DateTime            @default(now())
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id])
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  supplierName     String
  items            PurchaseOrderItem[]
  totalAmount      Decimal
  status           POStatus
  expectedDelivery DateTime?
  createdBy        String              // Simplifying for this relation, could link to User
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String
  productName      String
  requiredQty      Int
  lastPurchaseRate Decimal
  expectedRate     Decimal
  receivedQty      Int           @default(0)
  remarks          String?
}

enum POStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
}

// ── GRN ───────────────────────────────────────────────────────
model GRN {
  id                    String    @id @default(cuid())
  grnNumber             String    @unique
  date                  DateTime  @default(now())
  branchId              String?
  branch                Branch?   @relation(fields: [branchId], references: [id])
  poId                  String?
  supplierId            String
  supplier              Supplier  @relation(fields: [supplierId], references: [id])
  supplierName          String
  supplierInvoiceNo     String
  supplierInvoiceDate   DateTime
  supplierInvoiceAmount Decimal
  items                 GRNItem[]
  totalAmount           Decimal
  status                GRNStatus
  // True if this GRN was created to receive replacement goods (does NOT add to supplier outstanding)
  isReplacement         Boolean   @default(false)
  purchaseReturns       PurchaseReturn[]
}

model GRNItem {
  id           String   @id @default(cuid())
  grnId        String
  grn          GRN      @relation(fields: [grnId], references: [id])
  productId    String
  productName  String
  orderedQty   Int
  receivedQty  Int
  freeQty      Int      @default(0)
  batchNumber  String
  mfgDate      DateTime
  expiryDate   DateTime
  purchaseRate Decimal
  mrp          Decimal
  damageQty    Int      @default(0)
}

enum GRNStatus {
  DRAFT
  RECEIVED
  VERIFIED
}

// ── Expenses ──────────────────────────────────────────────────
model Expense {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  category     String
  description  String
  amount       Decimal
  paymentMode  String
  receiptImage String?
}

// ── Credit Notes (Sales Returns from Customers) ───────────────
model CreditNote {
  id              String           @id @default(cuid())
  creditNoteNo    String           @unique
  date            DateTime         @default(now())
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  invoiceNumber   String
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerName    String
  reason          String
  items           CreditNoteItem[]
  subtotal        Decimal
  cgst            Decimal          @default(0)
  sgst            Decimal          @default(0)
  igst            Decimal          @default(0)
  totalAmount     Decimal
  settlementMode  SettlementMode   @default(REFUND)
  // Set when the credit note is fully settled — i.e. customer has received
  // the refund (REFUND), the credit has been applied (CREDIT — auto-set on
  // create), or the replacement invoice has been issued (REPLACEMENT).
  // Null = pending settlement.
  settledAt       DateTime?
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
}

model CreditNoteItem {
  id              String     @id @default(cuid())
  creditNoteId    String
  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id])
  productId       String
  productName     String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  returnedQty     Int
  rate            Decimal
  gstPercent      Decimal
  amount          Decimal
}

enum SettlementMode {
  REFUND
  CREDIT
  REPLACEMENT
}

// ── Debit Notes / Purchase Returns (to Suppliers) ─────────────
model PurchaseReturn {
  id                String                     @id @default(cuid())
  debitNoteNo       String                     @unique
  date              DateTime                   @default(now())
  branchId          String?
  branch            Branch?                    @relation(fields: [branchId], references: [id])
  grnId             String?
  grn               GRN?                       @relation(fields: [grnId], references: [id])
  supplierId        String
  supplier          Supplier                   @relation(fields: [supplierId], references: [id])
  supplierName      String
  reason            String
  items             PurchaseReturnItem[]
  subtotal          Decimal
  cgst              Decimal                    @default(0)
  sgst              Decimal                    @default(0)
  igst              Decimal                    @default(0)
  totalAmount       Decimal
  status            PurchaseReturnStatus       @default(DRAFT)
  settlementMode    PurchaseReturnSettlement   @default(REFUND)
  replacementGrnId  String?
  notes             String?
  createdById       String
  createdAt         DateTime                   @default(now())

  // Set when an admin reversal has put back the wrongly-deducted stock for
  // this short-delivery debit note. Prevents the reverse endpoint from
  // adding the same qty twice on repeated calls.
  stockReversedAt   DateTime?
}

enum PurchaseReturnSettlement {
  REFUND
  REPLACEMENT
  ADJUST
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  productId        String
  productName      String
  batchId          String
  batchNumber      String
  expiryDate       DateTime
  returnedQty      Int
  purchaseRate     Decimal
  gstPercent       Decimal
  amount           Decimal
}

enum PurchaseReturnStatus {
  DRAFT
  SENT
  ACCEPTED
  SETTLED
}

// ── Audit Log ─────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  module    String
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ── Global Settings ───────────────────────────────────────────
model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Document Numbering ────────────────────────────────────────
// Atomic counter per (docType, branchScope, financialYear). Concurrent
// creators serialize on the same row via INSERT...ON CONFLICT DO UPDATE,
// which guarantees no duplicate numbers under load.
model DocumentSequence {
  id            String   @id @default(cuid())
  key           String   @unique // "PO:<branchId|GLOBAL>:<FY>"
  docType       String   // PO | GRN | DN
  branchId      String?
  financialYear String   // e.g. "26-27"
  counter       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([docType, branchId, financialYear])
}

// ── Discount Rules ────────────────────────────────────────────
model DiscountRule {
  id           String       @id @default(cuid())
  name         String
  type         DiscountType @default(PERCENTAGE)
  value        Decimal
  applicableTo String?
  validFrom    DateTime?
  validTo      DateTime?
  isActive     Boolean      @default(true)
  branchId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

// ── Quotations ────────────────────────────────────────────────
model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  date            DateTime        @default(now())
  branchId        String?
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  customerName    String
  customerPhone   String?
  items           QuotationItem[]
  subtotal        Decimal         @default(0)
  cgst            Decimal         @default(0)
  sgst            Decimal         @default(0)
  deliveryCharge  Decimal         @default(0)
  total           Decimal
  validUntil      DateTime?
  notes           String?
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?
  productName     String
  batchId         String?
  batchNumber     String?
  quantity        Int
  mrp             Decimal   @default(0)
  rate            Decimal
  discountPercent Decimal   @default(0)
  gstPercent      Decimal   @default(0)
  amount          Decimal
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

// ── Payment Records ───────────────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoiceId       String?       // null = customer-level lump payment (allocated below)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  amount          Decimal
  paymentMode     String        // CASH | CARD | UPI | CHEQUE | NEFT_UPI
  referenceNumber String?
  notes           String?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdAt       DateTime      @default(now())
}

// ── Notifications ─────────────────────────────────────────────
model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  isRead        Boolean          @default(false)
  actionUrl     String?
  branchId      String?
  branch        Branch?          @relation(fields: [branchId], references: [id])
  snoozedUntil  DateTime?
  // Stamped when the user takes the corrective action (e.g. records payment
  // for a Payment Due alert). Independent of isRead so we can show audit info.
  resolvedAt    DateTime?
  resolvedById  String?
  // Snapshot of the underlying entity's state at create time, e.g.
  // { totalStock: 5, minStock: 20 } for a Low Stock alert. Used by the
  // scheduler's escalation check — only re-fire when the situation has worsened.
  entityState   Json?
  createdAt     DateTime         @default(now())

  @@index([branchId, isRead, snoozedUntil])
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  PAYMENT_DUE
  SYSTEM
  APPROVAL
}

// ── Customer Reminders ────────────────────────────────────────
model CustomerReminder {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dayOfMonth   Int              // 1-31: repeat on this day each month
  title        String
  notes        String?
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  contacts     ReminderContact[]
}

model ReminderContact {
  id           String              @id @default(cuid())
  reminderId   String
  reminder     CustomerReminder    @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  contactedAt  DateTime            @default(now())
  status       ReminderContactStatus
  notes        String?
}

enum ReminderContactStatus {
  TALKED
  NOT_RESPONDED
  DENIED
  NEED_TO_TALK
  SCHEDULED
}

// ── Approval Requests ─────────────────────────────────────────
model ApprovalRequest {
  id            String              @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus      @default(PENDING)
  requestedById String
  requestedBy   User                @relation("ApprovalRequests", fields: [requestedById], references: [id])
  requestedAt   DateTime            @default(now())
  reviewedById  String?
  reviewedBy    User?               @relation("ApprovalReviews", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  payload       Json
  refId         String?             // id of the draft invoice / customer / return after creation
  branchId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum ApprovalType {
  NEW_CUSTOMER
  CREDIT_BILL
  SALES_RETURN
  PURCHASE_RETURN
  INVENTORY_ADJUSTMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────
// ── CRM: Leads / Contacts / Companies ────────────────────────
// ─────────────────────────────────────────────────────────────

enum LeadStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadStatus {
  OPEN
  CLOSED
}

enum LeadTouchStatus {
  TOUCHED
  UNTOUCHED
}

enum LeadSource {
  MANUAL
  INDIAMART
  REFERRAL
  WEBSITE
  WHATSAPP
  CALL
  EMAIL
  OTHER
}

enum LeadPipeline {
  SALES
  PROCUREMENT
  SUPPORT
}

// IndiaMART QUERY_TYPE: W=Direct Enquiry, B=Buy-Lead, P=PNS Call,
// BIZ=Catalog-view, WA=WhatsApp Enquiry. Stored verbatim from upstream.
enum IndiamartQueryType {
  W
  B
  P
  BIZ
  WA
}

enum ContactStatus {
  ACTIVE
  INACTIVE
}

enum LeadActivityType {
  CALL
  WHATSAPP
  EMAIL
  NOTE
  REMINDER
}

enum LeadActivityStatus {
  PENDING
  DONE
  CANCELLED
}

// Companies are lightweight — just enough to group contacts/leads.
// Not the same thing as Customer (which represents an actual billing party).
model Company {
  id        String    @id @default(cuid())
  name      String
  website   String?
  industry  String?
  address   String?
  city      String?
  state     String?
  country   String?
  branchId  String
  branch    Branch    @relation(fields: [branchId], references: [id])
  contacts  Contact[]
  leads     Lead[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([branchId, name])
}

// Contact = a person we might do business with. Belongs to a branch, may
// belong to a Company, may eventually be PROMOTED into a real Customer
// (when their lead wins). One-to-one promotion link via promotedCustomerId.
model Contact {
  id                  String        @id @default(cuid())
  firstName           String
  lastName            String?
  phoneCountryCode    String        @default("+91")
  phone               String
  email               String?
  jobTitle            String?
  companyId           String?
  company             Company?      @relation(fields: [companyId], references: [id])
  address             String?
  city                String?
  state               String?
  country             String?
  countryIso          String?
  source              LeadSource    @default(MANUAL)
  status              ContactStatus @default(ACTIVE)
  ownerUserId         String
  ownerUser           User          @relation("ContactOwner", fields: [ownerUserId], references: [id])
  branchId            String
  branch              Branch        @relation(fields: [branchId], references: [id])
  promotedCustomerId  String?       @unique
  promotedCustomer    Customer?     @relation("ContactPromotion", fields: [promotedCustomerId], references: [id])
  leads               Lead[]
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([branchId, phone])
  @@index([branchId, email])
}

// Lead = a sales opportunity. Always anchored to a Contact (the person);
// optionally to a Company. IndiaMART-sourced leads keep their original
// UNIQUE_QUERY_ID in externalQueryId for idempotency.
model Lead {
  id                  String          @id @default(cuid())
  leadNumber          String          @unique
  title               String
  description         String?
  source              LeadSource      @default(MANUAL)
  pipeline            LeadPipeline    @default(SALES)
  stage               LeadStage       @default(LEAD)
  status              LeadStatus      @default(OPEN)
  touchStatus         LeadTouchStatus @default(UNTOUCHED)
  score               Int             @default(50)
  value               Decimal         @default(0)
  currency            String          @default("INR")
  expectedCloseDate   DateTime?
  validUntil          DateTime?

  contactId           String
  contact             Contact         @relation(fields: [contactId], references: [id])
  companyId           String?
  company             Company?        @relation(fields: [companyId], references: [id])

  assignedToUserId    String
  assignedToUser      User            @relation("LeadAssignee", fields: [assignedToUserId], references: [id])

  branchId            String
  branch              Branch          @relation(fields: [branchId], references: [id])

  // IndiaMART payload bits (only populated when source=INDIAMART).
  // externalQueryId is the dedupe key — see indiamart-sync.service.
  externalQueryId     String?            @unique
  externalQueryType   IndiamartQueryType?
  externalQueryTime   DateTime?
  externalMessage     String?
  externalProductName String?
  externalCategory    String?
  externalCity        String?
  externalState       String?
  externalCountryIso  String?
  externalRaw         Json?

  activities          LeadActivity[]
  quotations          Quotation[]
  invoices            Invoice[]

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([branchId, stage, status])
  @@index([assignedToUserId])
  @@index([source, createdAt])
  @@index([touchStatus])
  @@index([contactId])
}

// Mirrors CustomerActivity/SupplierActivity exactly — same five types,
// same reminder lifecycle. Kept as its own table so list/filter queries
// stay scoped per-lead without joining across noisy parent tables.
model LeadActivity {
  id          String              @id @default(cuid())
  leadId      String
  lead        Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        LeadActivityType
  notes       String?
  title       String?
  occurredAt  DateTime?
  dueAt       DateTime?
  status      LeadActivityStatus? @default(PENDING)
  contactName String?
  subject     String?

  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  branchId    String?
  branch      Branch?             @relation(fields: [branchId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([leadId, createdAt])
  @@index([leadId, type])
}

// ─────────────────────────────────────────────────────────────
// ── Integrations (IndiaMART Pull API v2 and friends) ─────────
// ─────────────────────────────────────────────────────────────

enum IntegrationProvider {
  INDIAMART
}

enum SyncJobStatus {
  RUNNING
  SUCCESS
  FAILED
  RATE_LIMITED
  NO_NEW_LEADS
}

// Stores the encrypted API key per (provider, branch) and tracks the
// rolling watermark used by Strategy-2 (overlap window = lastEnd − 5 min).
model IntegrationCredential {
  id                    String              @id @default(cuid())
  provider              IntegrationProvider
  branchId              String
  branch                Branch              @relation(fields: [branchId], references: [id])
  // Push API: the high-entropy URL-path secret. IndiaMART POSTs to
  // `<APP_PUBLIC_URL>/api/v1/integrations/indiamart/webhook/<webhookToken>`
  // and we use the token to route the incoming lead to the right branch.
  // Stored as plaintext because the token IS the URL the seller pastes
  // into IndiaMART's panel — protecting it inside our DB doesn't help
  // once the URL leaves our system.
  webhookToken          String?             @unique
  // Pull API (legacy) — kept nullable for backward compatibility while we
  // migrate to Push. New rows leave these null.
  apiKeyCiphertext      String?             // AES-256-GCM ciphertext
  apiKeyIv              String?             // base64 IV
  apiKeyTag             String?             // base64 auth tag
  isActive              Boolean             @default(true)
  lastVerifiedAt        DateTime?
  lastSuccessfulEndTime DateTime?           // legacy: Pull watermark; Push uses lastVerifiedAt for "last received"
  cooldownUntil         DateTime?           // legacy: Pull rate-limit cooldown; unused for Push
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([provider, branchId])
  @@index([isActive, provider])
}

// Audit log of every pull, including raw error responses. Used by the
// admin "Sync Jobs" screen to show last 50 attempts + replay one if needed.
model IntegrationSyncJob {
  id               String              @id @default(cuid())
  provider         IntegrationProvider
  branchId         String
  branch           Branch              @relation(fields: [branchId], references: [id])
  startTime        DateTime
  endTime          DateTime
  status           SyncJobStatus
  totalRecords     Int                 @default(0)
  newLeadsCount    Int                 @default(0)
  dupeSkippedCount Int                 @default(0)
  errorCode        Int?
  errorMessage     String?
  rawRequestUrl    String?
  rawResponseSize  Int?
  startedAt        DateTime            @default(now())
  finishedAt       DateTime?

  @@index([branchId, provider, startedAt])
  @@index([status])
}
