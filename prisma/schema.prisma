generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Branch / Location ─────────────────────────────────────────
model Branch {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique  // short code e.g. "HQ", "BR1"
  address     String?
  phone       String?
  email       String?
  gstin       String?
  drugLicense String?
  isActive    Boolean   @default(true)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  users           User[]
  invoices        Invoice[]
  expenses        Expense[]
  purchaseOrders  PurchaseOrder[]
  grns            GRN[]
  creditNotes     CreditNote[]
  purchaseReturns PurchaseReturn[]
  products        Product[]
  customers       Customer[]
  suppliers       Supplier[]
  doctors         Doctor[]
  prescriptions   Prescription[]
  notifications   Notification[]
  payments        Payment[]
  reminders       CustomerReminder[]
  categories      Category[]
}

// ── Users & Auth ──────────────────────────────────────────────
model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String
  password       String    // bcrypt hashed
  role           Role      @default(PHARMACIST)
  isActive       Boolean   @default(true)
  lastLogin      DateTime?
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  commissionRate Decimal   @default(0) // % commission for SALESPERSON role
  createdAt      DateTime  @default(now())
  invoices             Invoice[]          @relation("UserInvoices")
  salespersonInvoices  Invoice[]          @relation("SalespersonInvoices")
  auditLogs            AuditLog[]
  approvalRequests     ApprovalRequest[]  @relation("ApprovalRequests")
  approvalReviews      ApprovalRequest[]  @relation("ApprovalReviews")
}

enum Role {
  ADMIN
  PHARMACIST
  INVENTORY_MANAGER
  ACCOUNTANT
  SALESPERSON
}

// ── Customers ─────────────────────────────────────────────────
model Customer {
  id                 String         @id @default(cuid())
  name               String
  phone              String
  alternatePhone     String?
  email              String?
  address            String?
  type               CustomerType   @default(RETAIL)
  doctorRef          String?
  referredBy         String?        // salesperson name
  creditLimit        Decimal        @default(0)
  currentOutstanding Decimal        @default(0)
  loyaltyPoints      Int            @default(0)
  gstin              String?
  dlNumber           String?
  notes              String?
  branchId           String?
  branch             Branch?        @relation(fields: [branchId], references: [id])
  createdAt          DateTime       @default(now())
  invoices           Invoice[]
  prescriptions      Prescription[]
  creditNotes        CreditNote[]
  quotations         Quotation[]
  payments           Payment[]
  reminders          CustomerReminder[]
}

enum CustomerType {
  RETAIL
  WHOLESALE
  DOCTOR
}

// ── Prescriptions ─────────────────────────────────────────────
model Prescription {
  id         String    @id @default(cuid())
  branchId   String?
  branch     Branch?   @relation(fields: [branchId], references: [id])
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id])
  doctorName String
  imageUrl   String?   // uploaded file path / S3 URL
  notes      String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  validUntil DateTime?
}

// ── Categories ────────────────────────────────────────────────
model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?   // hex color for UI badge
  isActive    Boolean   @default(true)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@unique([name, branchId])
}

// ── Products & Batches ────────────────────────────────────────
model Product {
  id               String           @id @default(cuid())
  name             String
  genericName      String
  saltComposition  String?
  manufacturer     String
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  subCategory      String?
  packSize         String
  unitOfMeasure    String
  schedule         Schedule         @default(NONE)
  hsnCode          String
  isNarcotic       Boolean          @default(false)
  storageCondition StorageCondition
  mrp              Decimal
  purchaseRate     Decimal
  sellingRate      Decimal
  wholesaleRate    Decimal
  gstRate          Decimal
  minStock         Int
  maxStock         Int
  reorderQty       Int
  rackLocation     String
  barcode          String?
  totalStock       Int              @default(0)
  isActive         Boolean          @default(true)
  branchId         String?
  branch           Branch?          @relation(fields: [branchId], references: [id])
  batches          Batch[]
  alternatives     Product[]        @relation("Alternatives")
  alternativesOf   Product[]        @relation("Alternatives")
  adjustmentLogs   StockAdjustmentLog[]
  createdAt        DateTime         @default(now())

  @@unique([barcode, branchId])
}

model StockAdjustmentLog {
  id            String   @id @default(cuid())
  adjustmentNo  String?
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId       String
  batchNumber   String
  userId        String
  userName      String
  reason        String
  previousQty   Int
  adjustedQty   Int
  diff          Int
  notes         String?
  branchId      String?
  createdAt     DateTime @default(now())
}

enum Schedule {
  NONE
  H
  H1
  X
}

enum StorageCondition {
  ROOM_TEMP
  COOL_DRY
  REFRIGERATED
  FROZEN
}

model Batch {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  batchNumber  String
  mfgDate      DateTime
  expiryDate   DateTime
  quantity     Int
  mrp          Decimal
  purchaseRate Decimal
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  createdAt    DateTime @default(now())
}

// ── Suppliers ─────────────────────────────────────────────────
model Supplier {
  id                  String           @id @default(cuid())
  name                String
  contactPerson       String
  phone               String
  email               String
  gstin               String
  drugLicense         String
  address             String
  paymentTerms        PaymentTerms
  bankDetails         String?
  isActive            Boolean          @default(true)
  // Money WE OWE this supplier — increases on GRN (received goods on credit), decreases on payment or ADJUST debit note
  currentOutstanding  Decimal          @default(0)
  branchId            String?
  branch              Branch?          @relation(fields: [branchId], references: [id])
  batches             Batch[]
  purchaseOrders      PurchaseOrder[]
  grns                GRN[]
  purchaseReturns     PurchaseReturn[]
}

enum PaymentTerms {
  NET_30
  NET_45
  NET_60
}

// ── Doctors ───────────────────────────────────────────────────
model Doctor {
  id             String    @id @default(cuid())
  name           String
  specialization String
  phone          String
  regNumber      String?
  email          String?
  address        String?
  isActive       Boolean   @default(true)
  branchId       String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  createdAt      DateTime  @default(now())
  invoices       Invoice[]
}

// ── Invoices ──────────────────────────────────────────────────
model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  date            DateTime      @default(now())
  type            InvoiceType
  billingType     BillingType
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  customerName    String
  doctorId        String?
  doctor          Doctor?       @relation(fields: [doctorId], references: [id])
  doctorName      String?
  salespersonId   String?
  salesperson     User?         @relation("SalespersonInvoices", fields: [salespersonId], references: [id])
  salespersonName String?
  items           InvoiceItem[]
  subtotal        Decimal
  productDiscount Decimal       @default(0)
  taxableAmount   Decimal
  cgst            Decimal
  sgst            Decimal
  igst            Decimal       @default(0)
  roundOff        Decimal       @default(0)
  grandTotal      Decimal
  paymentMode     PaymentMode
  paymentDetails  Json?
  status          InvoiceStatus
  amountPaid      Decimal
  changeReturned  Decimal       @default(0)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], name: "UserInvoices")
  createdAt       DateTime      @default(now())
  creditNotes     CreditNote[]
  payments        Payment[]
}

model InvoiceItem {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  productId       String
  productName     String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  quantity        Int
  mrp             Decimal
  rate            Decimal
  discountPercent Decimal
  gstPercent      Decimal
  amount          Decimal
}

enum InvoiceType {
  INVOICE
  QUOTATION
}

enum BillingType {
  RETAIL
  WHOLESALE
}

enum PaymentMode {
  CASH
  CARD
  UPI
  CREDIT
  SPLIT
}

enum InvoiceStatus {
  DRAFT
  PAID
  CREDIT
  PARTIAL
  RETURNED
  CANCELLED
}

// ── Purchase Orders ───────────────────────────────────────────
model PurchaseOrder {
  id               String              @id @default(cuid())
  poNumber         String              @unique
  date             DateTime            @default(now())
  branchId         String?
  branch           Branch?             @relation(fields: [branchId], references: [id])
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  supplierName     String
  items            PurchaseOrderItem[]
  totalAmount      Decimal
  status           POStatus
  expectedDelivery DateTime?
  createdBy        String              // Simplifying for this relation, could link to User
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId        String
  productName      String
  requiredQty      Int
  lastPurchaseRate Decimal
  expectedRate     Decimal
  receivedQty      Int           @default(0)
  remarks          String?
}

enum POStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PARTIALLY_RECEIVED
  FULLY_RECEIVED
  CLOSED
}

// ── GRN ───────────────────────────────────────────────────────
model GRN {
  id                    String    @id @default(cuid())
  grnNumber             String    @unique
  date                  DateTime  @default(now())
  branchId              String?
  branch                Branch?   @relation(fields: [branchId], references: [id])
  poId                  String?
  supplierId            String
  supplier              Supplier  @relation(fields: [supplierId], references: [id])
  supplierName          String
  supplierInvoiceNo     String
  supplierInvoiceDate   DateTime
  supplierInvoiceAmount Decimal
  items                 GRNItem[]
  totalAmount           Decimal
  status                GRNStatus
  // True if this GRN was created to receive replacement goods (does NOT add to supplier outstanding)
  isReplacement         Boolean   @default(false)
  purchaseReturns       PurchaseReturn[]
}

model GRNItem {
  id           String   @id @default(cuid())
  grnId        String
  grn          GRN      @relation(fields: [grnId], references: [id])
  productId    String
  productName  String
  orderedQty   Int
  receivedQty  Int
  freeQty      Int      @default(0)
  batchNumber  String
  mfgDate      DateTime
  expiryDate   DateTime
  purchaseRate Decimal
  mrp          Decimal
  damageQty    Int      @default(0)
}

enum GRNStatus {
  DRAFT
  RECEIVED
  VERIFIED
}

// ── Expenses ──────────────────────────────────────────────────
model Expense {
  id           String   @id @default(cuid())
  date         DateTime @default(now())
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  category     String
  description  String
  amount       Decimal
  paymentMode  String
  receiptImage String?
}

// ── Credit Notes (Sales Returns from Customers) ───────────────
model CreditNote {
  id              String           @id @default(cuid())
  creditNoteNo    String           @unique
  date            DateTime         @default(now())
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])
  invoiceId       String
  invoice         Invoice          @relation(fields: [invoiceId], references: [id])
  invoiceNumber   String
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerName    String
  reason          String
  items           CreditNoteItem[]
  subtotal        Decimal
  cgst            Decimal          @default(0)
  sgst            Decimal          @default(0)
  igst            Decimal          @default(0)
  totalAmount     Decimal
  settlementMode  SettlementMode   @default(REFUND)
  // Set when the credit note is fully settled — i.e. customer has received
  // the refund (REFUND), the credit has been applied (CREDIT — auto-set on
  // create), or the replacement invoice has been issued (REPLACEMENT).
  // Null = pending settlement.
  settledAt       DateTime?
  notes           String?
  createdById     String
  createdAt       DateTime         @default(now())
}

model CreditNoteItem {
  id              String     @id @default(cuid())
  creditNoteId    String
  creditNote      CreditNote @relation(fields: [creditNoteId], references: [id])
  productId       String
  productName     String
  batchId         String
  batchNumber     String
  expiryDate      DateTime
  returnedQty     Int
  rate            Decimal
  gstPercent      Decimal
  amount          Decimal
}

enum SettlementMode {
  REFUND
  CREDIT
  REPLACEMENT
}

// ── Debit Notes / Purchase Returns (to Suppliers) ─────────────
model PurchaseReturn {
  id                String                     @id @default(cuid())
  debitNoteNo       String                     @unique
  date              DateTime                   @default(now())
  branchId          String?
  branch            Branch?                    @relation(fields: [branchId], references: [id])
  grnId             String?
  grn               GRN?                       @relation(fields: [grnId], references: [id])
  supplierId        String
  supplier          Supplier                   @relation(fields: [supplierId], references: [id])
  supplierName      String
  reason            String
  items             PurchaseReturnItem[]
  subtotal          Decimal
  cgst              Decimal                    @default(0)
  sgst              Decimal                    @default(0)
  igst              Decimal                    @default(0)
  totalAmount       Decimal
  status            PurchaseReturnStatus       @default(DRAFT)
  settlementMode    PurchaseReturnSettlement   @default(REFUND)
  replacementGrnId  String?
  notes             String?
  createdById       String
  createdAt         DateTime                   @default(now())

  // Set when an admin reversal has put back the wrongly-deducted stock for
  // this short-delivery debit note. Prevents the reverse endpoint from
  // adding the same qty twice on repeated calls.
  stockReversedAt   DateTime?
}

enum PurchaseReturnSettlement {
  REFUND
  REPLACEMENT
  ADJUST
}

model PurchaseReturnItem {
  id               String         @id @default(cuid())
  purchaseReturnId String
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id])
  productId        String
  productName      String
  batchId          String
  batchNumber      String
  expiryDate       DateTime
  returnedQty      Int
  purchaseRate     Decimal
  gstPercent       Decimal
  amount           Decimal
}

enum PurchaseReturnStatus {
  DRAFT
  SENT
  ACCEPTED
  SETTLED
}

// ── Audit Log ─────────────────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  module    String
  action    String
  entity    String
  entityId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  createdAt DateTime @default(now())
}

// ── Global Settings ───────────────────────────────────────────
model GlobalSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Document Numbering ────────────────────────────────────────
// Atomic counter per (docType, branchScope, financialYear). Concurrent
// creators serialize on the same row via INSERT...ON CONFLICT DO UPDATE,
// which guarantees no duplicate numbers under load.
model DocumentSequence {
  id            String   @id @default(cuid())
  key           String   @unique // "PO:<branchId|GLOBAL>:<FY>"
  docType       String   // PO | GRN | DN
  branchId      String?
  financialYear String   // e.g. "26-27"
  counter       Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([docType, branchId, financialYear])
}

// ── Discount Rules ────────────────────────────────────────────
model DiscountRule {
  id           String       @id @default(cuid())
  name         String
  type         DiscountType @default(PERCENTAGE)
  value        Decimal
  applicableTo String?
  validFrom    DateTime?
  validTo      DateTime?
  isActive     Boolean      @default(true)
  branchId     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

// ── Quotations ────────────────────────────────────────────────
model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  date            DateTime        @default(now())
  branchId        String?
  customerId      String?
  customer        Customer?       @relation(fields: [customerId], references: [id])
  customerName    String
  items           QuotationItem[]
  subtotal        Decimal         @default(0)
  cgst            Decimal         @default(0)
  sgst            Decimal         @default(0)
  total           Decimal
  validUntil      DateTime?
  notes           String?
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String?
  productName     String
  batchId         String?
  batchNumber     String?
  quantity        Int
  mrp             Decimal   @default(0)
  rate            Decimal
  discountPercent Decimal   @default(0)
  gstPercent      Decimal   @default(0)
  amount          Decimal
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
}

// ── Payment Records ───────────────────────────────────────────
model Payment {
  id              String        @id @default(cuid())
  receiptNumber   String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoiceId       String?       // null = customer-level lump payment (allocated below)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  amount          Decimal
  paymentMode     String        // CASH | CARD | UPI | CHEQUE | NEFT_UPI
  referenceNumber String?
  notes           String?
  branchId        String?
  branch          Branch?       @relation(fields: [branchId], references: [id])
  createdAt       DateTime      @default(now())
}

// ── Notifications ─────────────────────────────────────────────
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  message    String
  isRead     Boolean          @default(false)
  actionUrl  String?
  branchId   String?
  branch     Branch?          @relation(fields: [branchId], references: [id])
  createdAt  DateTime         @default(now())
}

enum NotificationType {
  LOW_STOCK
  EXPIRY
  PAYMENT_DUE
  SYSTEM
  APPROVAL
}

// ── Customer Reminders ────────────────────────────────────────
model CustomerReminder {
  id           String           @id @default(cuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  dayOfMonth   Int              // 1-31: repeat on this day each month
  title        String
  notes        String?
  branchId     String?
  branch       Branch?          @relation(fields: [branchId], references: [id])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  contacts     ReminderContact[]
}

model ReminderContact {
  id           String              @id @default(cuid())
  reminderId   String
  reminder     CustomerReminder    @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  contactedAt  DateTime            @default(now())
  status       ReminderContactStatus
  notes        String?
}

enum ReminderContactStatus {
  TALKED
  NOT_RESPONDED
  DENIED
  NEED_TO_TALK
  SCHEDULED
}

// ── Approval Requests ─────────────────────────────────────────
model ApprovalRequest {
  id            String              @id @default(cuid())
  type          ApprovalType
  status        ApprovalStatus      @default(PENDING)
  requestedById String
  requestedBy   User                @relation("ApprovalRequests", fields: [requestedById], references: [id])
  requestedAt   DateTime            @default(now())
  reviewedById  String?
  reviewedBy    User?               @relation("ApprovalReviews", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewNote    String?
  payload       Json
  refId         String?             // id of the draft invoice / customer / return after creation
  branchId      String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum ApprovalType {
  NEW_CUSTOMER
  CREDIT_BILL
  SALES_RETURN
  PURCHASE_RETURN
  INVENTORY_ADJUSTMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
