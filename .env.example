# ──────────────────────────────────────────────────────────────────
# Backend environment template
#
# Copy this file to `.env` and fill in real values. The actual `.env`
# is gitignored — never commit secrets.
# ──────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
#
# Local Postgres example:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/pbims_db?schema=public"
#
# Neon (serverless Postgres) — note these query params:
#   sslmode=require              required by Neon
#   channel_binding=require      required by Neon
#   connect_timeout=30           wait up to 30s for the compute to wake from idle
#   connection_limit=20          Prisma client pool size (default is cpus*2+1, ~9 — too low for Neon under burst load)
#   pool_timeout=20              wait up to 20s for a free connection before giving up
#
# Use the `-pooler` host (pgBouncer) so connections are reused efficiently.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&connect_timeout=30&connection_limit=20&pool_timeout=20"

# ─── JWT ─────────────────────────────────────────────────────────
# Generate a 64-byte secret with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_64_BYTES_BASE64"
JWT_EXPIRES_IN="8h"

# Optional — refresh tokens are not currently wired up in code, but the
# values are reserved here for future use.
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────
PORT=3001

# Allowed origin for CORS / OAuth redirects (used by deployment configs,
# not directly read in code today).
FRONTEND_URL="http://localhost:5173"
