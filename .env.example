# ──────────────────────────────────────────────────────────────────
# Backend environment template
#
# Copy this file to `.env` and fill in real values. The actual `.env`
# is gitignored — never commit secrets.
# ──────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
#
# Local Postgres example:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/pbims_db?schema=public"
#
# Neon (serverless Postgres) — note these query params:
#   sslmode=require              required by Neon
#   channel_binding=require      required by Neon
#   connect_timeout=30           wait up to 30s for the compute to wake from idle
#   connection_limit=20          Prisma client pool size (default is cpus*2+1, ~9 — too low for Neon under burst load)
#   pool_timeout=20              wait up to 20s for a free connection before giving up
#
# Use the `-pooler` host (pgBouncer) so connections are reused efficiently.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require&connect_timeout=30&connection_limit=20&pool_timeout=20"

# ─── JWT ─────────────────────────────────────────────────────────
# Generate a 64-byte secret with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_64_BYTES_BASE64"
JWT_EXPIRES_IN="8h"

# Optional — refresh tokens are not currently wired up in code, but the
# values are reserved here for future use.
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_RANDOM_SECRET"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ─────────────────────────────────────────────────────────
PORT=3001

# Max number of unsettled credit invoices a customer can carry before a
# fresh credit sale requires admin approval. Default 3.
MAX_PENDING_CREDIT=3

# Allowed origin for CORS / OAuth redirects (used by deployment configs,
# not directly read in code today).
FRONTEND_URL="http://localhost:5173"

# ─── Cloudflare R2 (shared-files / WhatsApp PDF delivery) ───────
# Customer-facing invoice/quotation PDFs are stored in an R2 bucket so the
# links survive backend restarts and load from Cloudflare's edge. The bucket
# must have public access enabled — security comes from the unguessable
# UUIDv4 in the object key.
#
# R2_ACCOUNT_ID      — your Cloudflare account id (Dashboard → R2 → Overview)
# R2_ACCESS_KEY_ID   — created under R2 → Manage R2 API Tokens (read+write)
# R2_SECRET_ACCESS_KEY — companion secret to the access key
# R2_BUCKET_NAME     — the bucket name you created in R2
# R2_PUBLIC_URL      — the public base URL of the bucket (Dashboard → bucket
#                      → Settings → Public Access). Either `https://pub-XXX.r2.dev`
#                      or a custom domain you've attached. NO trailing slash.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="pbims-shared-files"
R2_PUBLIC_URL="https://pub-XXXXXXXX.r2.dev"

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────
# Meta Business Manager — https://developers.facebook.com
# META_WHATSAPP_TOKEN     — permanent System User token for the WABA
# META_PHONE_NUMBER_ID    — the sending phone number's id
# META_WABA_ID            — WhatsApp Business Account id
# META_VERIFY_TOKEN       — any string you choose; set the same value in
#                           Meta's webhook config UI
# META_APP_SECRET         — used to verify inbound webhook signatures
META_WHATSAPP_TOKEN=""
META_PHONE_NUMBER_ID=""
META_WABA_ID=""
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v25.0"
#
# Master switch for invoice/QR-payment WhatsApp sends. When false: invoice
# creation still works, the listener is a no-op, no external calls.
WHATSAPP_AUTO_SEND_ENABLED="false"
#
# ─── Outbound call timeouts (ms) ─────────────────────────────────
# The invoice→WhatsApp flow chains Razorpay, R2 and Meta. None of those SDKs
# time out on their own, and a stalled call used to hang the send forever —
# leaving the invoice stuck behind InvoiceCreatedListener's in-flight guard and
# un-sendable until the process restarted. Defaults below are applied in code;
# only set these to widen a limit on a slow network.
# RAZORPAY_TIMEOUT_MS="20000"
# R2_CONNECT_TIMEOUT_MS="5000"
# R2_REQUEST_TIMEOUT_MS="30000"
# META_TIMEOUT_MS="30000"
#
# Separate switch for the customer sale-reminder auto-WhatsApp
# (src/events/reminder-due-notification.listener.ts). Requires the
# "customer_sale_reminder" template to be approved in Meta Business Manager
# before messages actually deliver.
WHATSAPP_SALE_REMINDER_ENABLED="false"

# ─── IndiaMART Push API ─────────────────────────────────────────
# Public HTTPS base URL of THIS backend. IndiaMART POSTs each new lead to
# `<APP_PUBLIC_URL>/api/v1/integrations/indiamart/webhook/<token>`, so we
# need to know that public origin to build the URL the seller pastes into
# their Lead Manager panel.
#
# Production: your real domain (https://api.yourdomain.com — NO trailing slash).
# Dev: use an ngrok / cloudflared tunnel that points at this dev server.
APP_PUBLIC_URL=""

# ─── Delivery Tracking — Carrier API ────────────────────────────
# Live courier tracking on the Delivery Tracking page. Set ONE provider key.
# Both are multi-carrier aggregators (one key tracks ST Courier, The
# Professional Couriers, DTDC, Blue Dart, Delhivery, India Post, …). If both
# are set, TrackingMore wins.
#
# OPTIONAL — leave both blank to disable live sync. When empty, "Check Tracking
# Status" simply shows the manually-entered / OCR-extracted timeline and the
# UI reports that live sync isn't connected. When set, checkpoints are pulled
# from the carrier and merged into the timeline automatically.
#
# TrackingMore — https://my.trackingmore.com → Account → API Keys
#   (v4 API, header `Tracking-Api-Key`).
TRACKINGMORE_API_KEY=""
#
# AfterShip (alternative) — https://admin.aftership.com → Settings → API Keys
#   (v4 API, header `aftership-api-key`).
AFTERSHIP_API_KEY=""
