{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "pdf/templates/**/*.hbs", "outDir": "dist/src" },
      { "include": "pdf/templates/**/*.png", "outDir": "dist/src" }
    ],
    "watchAssets": true
  }
}
